// Beacon symbolic CLR planner.

// Beacon self-hosted compiler.
//
// Stage 0 exists only as the seed compiler. Once this file has been compiled
// once, compileSource() performs lexing, parsing, Core construction, and CLR
// plan generation in Beacon itself.

labelCounter: number = 0

nextLabel: fn(prefix: string) = [
    labelCounter += 1,
    prefix + labelCounter
]


isStatementForm: fn(node: atom | list | record) = [
    result: boolean = false,
    if isForm(node, "if") or isForm(node, "for") then
        result = true
    end,
    result
]

emitTarget: fn(node: atom | list | record) = [
    result: list = [],
    if kind(node) == "symbol" and node.name == "self" then
        result = [{ op: "ldself" }]
    else
        result = emit(node)
    end,
    result
]

compile: fn(program: list) = [
    labelCounter = 0,
    head: symbol = program@0,
    ops: list = [],

    if head.name != "do" then
        fail("Program Core must begin with do")
    end,

    for [i: number = 1, i < program.length(), i += 1]
        ops = ops.concat(emitStatement(program@i))
    loop,

    ops
]

emitStatement: fn(node: atom | list | record) = [
    result: list = [],
    if isForm(node, "if") then
        result = emitIf(node)
    else
        if isForm(node, "for") then
            result = emitFor(node)
        else
            result = emit(node)
            result.append({ op: "pop" })
        end
    end,
    result
]

emitDoStatements: fn(body: list) = [
    ops: list = [],
    for [i: number = 1, i < body.length(), i += 1]
        ops = ops.concat(emitStatement(body@i))
    loop,
    ops
]

emitFunctionBody: fn(body: atom | list | record) = [
    ops: list = [],
    if isForm(body, "do") then
        if body.length() == 1 then
            ops.append({ op: "ldnull" })
        else
            for [i: number = 1, i < body.length() - 1, i += 1]
                ops = ops.concat(emitStatement(body@i))
            loop
            last: atom | list | record = body@(body.length() - 1)
            if isStatementForm(last) then
                ops = ops.concat(emitStatement(last))
                ops.append({ op: "ldnull" })
            else
                ops = ops.concat(emit(last))
            end
        end
    else
        ops = emit(body)
    end,
    ops
]

emit: fn(node: atom | list | record) = [
    nodeKind: string = kind(node),
    result: list = [],

    if nodeKind == "list" then
        result = emitForm(node)
    else
        if nodeKind == "record" then
            result = emitRecord(node)
        else
            result = emitAtom(node)
        end
    end,

    result
]

emitAtom: fn(node: atom) = [
    nodeKind: string = kind(node),
    result: list = [],

    if nodeKind == "number" then
        result = [
            { op: "ldc.r8", arg: node },
            { op: "box", arg: "number" }
        ]
    else
        if nodeKind == "string" then
            result = [
                { op: "interpolate", text: node }
            ]
        else
            if nodeKind == "boolean" then
                result = [
                    { op: "ldbool", arg: node },
                    { op: "box", arg: "boolean" }
                ]
            else
                if nodeKind == "null" then
                    result = [{ op: "ldnull" }]
                else
                    if nodeKind == "symbol" then
                        if node.name == "self" then
                            result = [{ op: "ldself" }]
                        else
                            result = [
                                { op: "ldenv" },
                                { op: "ldstr", arg: node.name },
                                { op: "call", arg: "Runtime.GetVar" }
                            ]
                        end
                    else
                        fail("Unsupported Atom kind: {nodeKind}")
                    end
                end
            end
        end
    end,

    result
]

emitRecord: fn(node: record) = [
    keys: list = node.keys(),
    fields: list = [],

    for [i: number = 0, i < keys.length(), i += 1]
        key: string = keys@i
        fields.append({
            name: key,
            value: emit(node.get(key))
        })
    loop,

    [{ op: "record", fields: fields }]
]

emitForm: fn(node: list) = [
    head: symbol = node@0,
    form: string = head.name,
    result: list = [],
    handled: boolean = false,

    if form == "+" then
        result = emitBinary(node, "Runtime.Add")
        handled = true
    end,
    if form == "-" then
        result = emitBinary(node, "Runtime.Sub")
        handled = true
    end,
    if form == "*" then
        result = emitBinary(node, "Runtime.Mul")
        handled = true
    end,
    if form == "/" then
        result = emitBinary(node, "Runtime.Div")
        handled = true
    end,
    if form == "==" then
        result = emitEquality(node)
        handled = true
    end,
    if form == "!=" then
        result = emitNotEqual(node)
        handled = true
    end,
    if form == "<" or form == "<=" or form == ">" or form == ">=" then
        result = emitComparison(node, form)
        handled = true
    end,
    if form == "and" then
        result = emitLogicalAnd(node)
        handled = true
    end,
    if form == "or" then
        result = emitLogicalOr(node)
        handled = true
    end,
    if form == "not" then
        result = emitLogicalNot(node)
        handled = true
    end,
    if form == "list" then
        result = emitList(node)
        handled = true
    end,
    if form == "namespace" then
        result = emitNamespace(node)
        handled = true
    end,
    if form == "get" then
        result = emitGet(node)
        handled = true
    end,
    if form == "index" then
        result = emitIndex(node)
        handled = true
    end,
    if form == "def" then
        result = emitDefinition(node)
        handled = true
    end,
    if form == "=" then
        result = emitAssign(node)
        handled = true
    end,
    if form == "+=" then
        result = emitPlusAssign(node)
        handled = true
    end,
    if form == "call" then
        result = emitCall(node)
        handled = true
    end,
    if form == "fn" then
        result = emitFunction(node)
        handled = true
    end,
    if form == "type" then
        fail("type Core is emitted through its declaration")
    end,
    if form == "include" then
        fail("include is only valid at top level and must be resolved before emission")
    end,

    if not handled then
        fail("Self-hosted compiler does not emit Core form: {form}")
    end,

    result
]

emitBinary: fn(node: list, runtimeMethod: string) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: runtimeMethod }),
    ops
]

emitEquality: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Equal" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitNotEqual: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Equal" }),
    ops.append({ op: "not.bool" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitComparison: fn(node: list, operator: string) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "ldstr", arg: operator }),
    ops.append({ op: "call", arg: "Runtime.Compare" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalAnd: fn(node: list) = [
    falseLabel: string = nextLabel("and_false_"),
    endLabel: string = nextLabel("and_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: falseLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: falseLabel }),
    ops.append({ op: "ldbool", arg: false }),
    ops.append({ op: "label", name: endLabel }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalOr: fn(node: list) = [
    trueLabel: string = nextLabel("or_true_"),
    endLabel: string = nextLabel("or_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brtrue", label: trueLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: trueLabel }),
    ops.append({ op: "ldbool", arg: true }),
    ops.append({ op: "label", name: endLabel }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalNot: fn(node: list) = [
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "not.bool" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitList: fn(node: list) = [
    items: list = [],
    for [i: number = 1, i < node.length(), i += 1]
        items.append(emit(node@i))
    loop,
    [{ op: "list", items: items }]
]

emitNamespace: fn(node: list) = [
    body: list = node@1,
    children: record = node@2,
    names: list = namespaceExportNames(body),
    childKeys: list = children.keys(),
    childPlans: list = [],

    for [i: number = 0, i < childKeys.length(), i += 1]
        key: string = childKeys@i
        if listContainsString(names, key) then
            fail("Standard-library namespace member conflicts with child namespace: " + key)
        end
        childPlans.append({
            name: key,
            value: emit(children.get(key))
        })
    loop,

    [{
        op: "namespace",
        names: names,
        body: emitDoStatements(body),
        children: childPlans
    }]
]

emitGet: fn(node: list) = [
    ops: list = emitTarget(node@1),
    member: string = node@2,
    ops.append({ op: "ldstr", arg: member }),
    ops.append({ op: "call", arg: "Runtime.Get" }),
    ops
]

emitIndex: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Index" }),
    ops
]

emitDefinition: fn(node: list) = [
    name: symbol = node@1,
    declaredType: symbol = node@2,
    valuePlan: list = [],

    if declaredType.name == "type" then
        valuePlan = emitType(name.name, node@3)
    else
        valuePlan = emit(node@3)
    end,

    ops: list = [
        { op: "ldenv" },
        { op: "ldstr", arg: name.name },
        { op: "ldstr", arg: declaredType.name }
    ],
    ops = ops.concat(valuePlan),
    ops.append({ op: "call", arg: "Runtime.Declare" }),
    ops
]

emitAssign: fn(node: list) = [
    target: atom | list | record = node@1,
    value: atom | list | record = node@2,
    result: list = [],

    if kind(target) == "symbol" then
        result = [
            { op: "ldenv" },
            { op: "ldstr", arg: target.name }
        ]
        result = result.concat(emit(value))
        result.append({ op: "call", arg: "Runtime.SetVar" })
    else
        if isForm(target, "get") then
            result = emitTarget(target@1)
            result.append({ op: "ldstr", arg: target@2 })
            result = result.concat(emit(value))
            result.append({ op: "call", arg: "Runtime.SetMember" })
        else
            if isForm(target, "index") then
                result = emit(target@1)
                result = result.concat(emit(target@2))
                result = result.concat(emit(value))
                result.append({ op: "call", arg: "Runtime.SetIndex" })
            else
                fail("Left side of = must be a variable, member, or indexed value")
            end
        end
    end,

    result
]

emitPlusAssign: fn(node: list) = [
    target: atom | list | record = node@1,
    value: atom | list | record = node@2,
    result: list = [],

    if kind(target) == "symbol" then
        result = [
            { op: "ldenv" },
            { op: "ldstr", arg: target.name }
        ]
        result = result.concat(emit(value))
        result.append({ op: "call", arg: "Runtime.AddAssignVar" })
    else
        if isForm(target, "get") then
            result = emitTarget(target@1)
            result.append({ op: "ldstr", arg: target@2 })
            result = result.concat(emit(value))
            result.append({ op: "call", arg: "Runtime.AddAssignMember" })
        else
            fail("Left side of += must be a variable or member")
        end
    end,

    result
]

emitCall: fn(node: list) = [
    callee: atom | list | record = node@1,
    args: list = [],
    result: list = [],

    for [i: number = 2, i < node.length(), i += 1]
        args.append(emit(node@i))
    loop,

    if kind(callee) == "symbol" and callee.name == "print" then
        result = [{ op: "print", args: args }]
    else
        if kind(callee) == "symbol" and callee.name == "kind" then
            result = args@0
            result.append({ op: "call", arg: "Runtime.Kind" })
        else
            if kind(callee) == "symbol" and callee.name == "fail" then
                result = args@0
                result.append({ op: "call", arg: "Runtime.Fail" })
            else
                if kind(callee) == "symbol" and callee.name == "symbol" then
                    result = args@0
                    result.append({ op: "call", arg: "Runtime.Symbol" })
                else
                    if kind(callee) == "symbol" and callee.name == "number" then
                        result = args@0
                        result.append({ op: "call", arg: "Runtime.Number" })
                        result.append({ op: "box", arg: "number" })
                    else
                        if kind(callee) == "symbol" and callee.name == "readFile" then
                            result = args@0
                            result.append({ op: "call", arg: "Runtime.ReadFile" })
                        else
                            if kind(callee) == "symbol" and callee.name == "fileExists" then
                                result = args@0
                                result.append({ op: "call", arg: "Runtime.FileExists" })
                                result.append({ op: "box", arg: "boolean" })
                            else
                                if kind(callee) == "symbol" and callee.name == "absolutePath" then
                                    result = args@0
                                    result.append({ op: "call", arg: "Runtime.AbsolutePath" })
                                else
                                    if kind(callee) == "symbol" and callee.name == "directoryName" then
                                        result = args@0
                                        result.append({ op: "call", arg: "Runtime.DirectoryName" })
                                    else
                                        if kind(callee) == "symbol" and callee.name == "combinePath" then
                                            result = args@0
                                            result = result.concat(args@1)
                                            result.append({ op: "call", arg: "Runtime.CombinePath" })
                                        else
                                            if kind(callee) == "symbol" and callee.name == "environment" then
                                                result = args@0
                                                result.append({ op: "call", arg: "Runtime.EnvironmentValue" })
                                            else
                                                if isForm(callee, "get") then
                                                    result = [{
                                                        op: "invoke.member",
                                                        receiver: emitTarget(callee@1),
                                                        member: callee@2,
                                                        args: args
                                                    }]
                                                else
                                                    result = [{
                                                        op: "invoke",
                                                        callee: emit(callee),
                                                        args: args
                                                    }]
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end,

    result
]

emitFunctionClauses: fn(node: list) = [
    clauseValues: list = node@1,
    clauses: list = [],

    for [i: number = 1, i < clauseValues.length(), i += 1]
        clause: list = clauseValues@i
        if not isForm(clause, "fn") or clause.length() != 3 then
            fail("Function clause must be a function")
        end

        rawParams: list = clause@1
        parameterTypes: list = []
        for [p: number = 0, p < rawParams.length(), p += 1]
            parameter: record = rawParams@p
            paramType: symbol = parameter.type
            parameterTypes.append(paramType.name)
        loop

        clauses.append({
            value: emitFunction(clause)
            types: parameterTypes
        })
    loop,

    [{ op: "fn.clauses", clauses: clauses }]
]

emitFunction: fn(node: list) = [
    result: list = [],

    if node.length() == 2 then
        result = emitFunctionClauses(node)
    else
        rawParams: list = node@1
        params: list = []

        for [i: number = 0, i < rawParams.length(), i += 1]
            parameter: record = rawParams@i
            paramName: symbol = parameter.name
            paramType: symbol = parameter.type
            params.append({ name: paramName.name, type: paramType.name })
        loop

        result = [{
            op: "fn",
            params: params,
            body: emitFunctionBody(node@2)
        }]
    end,

    result
]

emitType: fn(typeName: string, node: list) = [
    members: record = node@1,
    keys: list = members.keys(),
    fields: list = [],
    methods: list = [],

    for [i: number = 0, i < keys.length(), i += 1]
        key: string = keys@i
        member: atom | list | record = members.get(key)
        if kind(member) == "symbol" then
            fields.append({ name: key, type: member.name })
        else
            if isForm(member, "fn") then
                methods.append({ name: key, value: emit(member) })
            else
                fail("Unsupported type member: {key}")
            end
        end
    loop,

    [{ op: "type", name: typeName, fields: fields, methods: methods }]
]

emitIf: fn(node: list) = [
    elseLabel: string = nextLabel("if_else_"),
    endLabel: string = nextLabel("if_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: elseLabel }),
    ops = ops.concat(emitDoStatements(node@2)),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: elseLabel }),
    ops = ops.concat(emitDoStatements(node@3)),
    ops.append({ op: "label", name: endLabel }),
    ops
]

emitFor: fn(node: list) = [
    conditionLabel: string = nextLabel("for_condition_"),
    endLabel: string = nextLabel("for_end_"),
    ops: list = emitStatement(node@1),
    ops.append({ op: "label", name: conditionLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: endLabel }),
    ops = ops.concat(emitDoStatements(node@4)),
    ops = ops.concat(emit(node@3)),
    ops.append({ op: "pop" }),
    ops.append({ op: "br", label: conditionLabel }),
    ops.append({ op: "label", name: endLabel }),
    ops
]

// --------------------------------------------------------------------------
