// Beacon lexer.

letters: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
digits: string = "0123456789"
identifierCharacters: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"

punctuationTable: list = [
    { char: ":", kind: "colon" },
    { char: "+", kind: "plus" },
    { char: "-", kind: "minus" },
    { char: "*", kind: "star" },
    { char: "/", kind: "slash" },
    { char: "<", kind: "less" },
    { char: ">", kind: "greater" },
    { char: "@", kind: "at" },
    { char: "|", kind: "pipe" },
    { char: "(", kind: "lparen" },
    { char: ")", kind: "rparen" },
    { char: "[", kind: "lbracket" },
    { char: "]", kind: "rbracket" },
    { char: "{", kind: "lbrace" },
    { char: "}", kind: "rbrace" },
    { char: ".", kind: "dot" },
    { char: ",", kind: "comma" },
    { char: "=", kind: "equal" }
]

makeToken: fn(tokenKind: string, tokenText: string, tokenLine: number, tokenColumn: number) = {
    kind: tokenKind
    text: tokenText
    line: tokenLine
    column: tokenColumn
}

peek: fn(source: string, index: number) = [
    result: string = "",
    if index >= 0 and index < source.length() then
        result = source@index
    end,
    result
]

containsCharacter: fn(characters: string, character: string) = [
    found: boolean = false,
    for [i: number = 0, i < characters.length(), i += 1]
        if characters@i == character then
            found = true
        end
    loop,
    found
]

isIdentifierStart: fn(character: string) = containsCharacter(letters, character)
isIdentifierPart: fn(character: string) = containsCharacter(identifierCharacters, character)
isDigit: fn(character: string) = containsCharacter(digits, character)

punctuationAt: fn(source: string, index: number) = [
    character: string = peek(source, index),
    next: string = peek(source, index + 1),
    pair: string = character + next,
    result: record = { matched: false, kind: "", text: "", width: 0 },

    if pair == "==" then
        result = { matched: true, kind: "eqeq", text: "==", width: 2 }
    else
        if pair == "!=" then
            result = { matched: true, kind: "bangeq", text: "!=", width: 2 }
        else
            if pair == "+=" then
                result = { matched: true, kind: "pluseq", text: "+=", width: 2 }
            else
                if pair == "<=" then
                    result = { matched: true, kind: "lesseq", text: "<=", width: 2 }
                else
                    if pair == ">=" then
                        result = { matched: true, kind: "greatereq", text: ">=", width: 2 }
                    end
                end
            end
        end
    end,

    if not result@"matched" then
        for [i: number = 0, i < punctuationTable.length(), i += 1]
            entry: record = punctuationTable@i
            if entry@"char" == character then
                result = { matched: true, kind: entry@"kind", text: character, width: 1 }
            end
        loop
    end,

    result
]

lex: fn(source: string) = [
    tokens: list = [],
    index: number = 0,
    line: number = 1,
    column: number = 1,

    for [tick: number = 0, index < source.length(), tick += 1]
        character: string = peek(source, index)

        if character == " " or character == "\t" then
            index += 1
            column += 1
        else
            if character == "\r" and peek(source, index + 1) == "\n" then
                index += 1
                column += 1
            else
                if character == "\n" then
                tokens.append(makeToken("newline", "\n", line, column))
                index += 1
                line += 1
                column = 1
            else
                if character == "/" and peek(source, index + 1) == "/" then
                    for [scan: number = index, index < source.length() and peek(source, index) != "\n", scan += 1]
                        index += 1
                        column += 1
                    loop
                else
                    if isIdentifierStart(character) then
                        start: number = index
                        startColumn: number = column
                        for [scan: number = index, index < source.length() and isIdentifierPart(peek(source, index)), scan += 1]
                            index += 1
                            column += 1
                        loop
                        tokens.append(makeToken("identifier", source.slice(start, index - start), line, startColumn))
                    else
                        if isDigit(character) then
                            numberStart: number = index
                            numberColumn: number = column
                            for [scan: number = index, index < source.length() and isDigit(peek(source, index)), scan += 1]
                                index += 1
                                column += 1
                            loop
                            if peek(source, index) == "." and isDigit(peek(source, index + 1)) then
                                index += 1
                                column += 1
                                for [decimalScan: number = index, index < source.length() and isDigit(peek(source, index)), decimalScan += 1]
                                    index += 1
                                    column += 1
                                loop
                            end
                            tokens.append(makeToken("number", source.slice(numberStart, index - numberStart), line, numberColumn))
                        else
                            if character == "\"" then
                                stringLine: number = line
                                stringColumn: number = column
                                text: string = ""
                                closed: boolean = false
                                index += 1
                                column += 1

                                for [scan: number = 0, index < source.length() and not closed, scan += 1]
                                    currentCharacter: string = peek(source, index)
                                    if currentCharacter == "\"" then
                                        closed = true
                                        index += 1
                                        column += 1
                                    else
                                        if currentCharacter == "\\" then
                                            escaped: string = peek(source, index + 1)
                                            if escaped == "n" then
                                                text = text + "\n"
                                            else
                                                if escaped == "r" then
                                                    text = text + "\r"
                                                else
                                                    if escaped == "t" then
                                                        text = text + "\t"
                                                    else
                                                        if escaped == "\"" then
                                                            text = text + "\""
                                                        else
                                                            if escaped == "\\" then
                                                                text = text + "\\"
                                                            else
                                                                text = text + escaped
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                            index += 2
                                            column += 2
                                        else
                                            text = text + currentCharacter
                                            if currentCharacter == "\n" then
                                                line += 1
                                                column = 1
                                            else
                                                column += 1
                                            end
                                            index += 1
                                        end
                                    end
                                loop

                                if not closed then
                                    fail("Unterminated string at {stringLine}:{stringColumn}")
                                end
                                tokens.append(makeToken("string", text, stringLine, stringColumn))
                            else
                                punctuation: record = punctuationAt(source, index)
                                if punctuation@"matched" then
                                    tokens.append(makeToken(punctuation@"kind", punctuation@"text", line, column))
                                    index += punctuation@"width"
                                    column += punctuation@"width"
                                else
                                    fail("Unexpected character at {line}:{column}")
                                end
                            end
                        end
                    end
                end
            end
        end
        end
    loop,

    tokens.append(makeToken("end", "", line, column)),
    tokens
]
