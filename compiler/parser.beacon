// Beacon parser: surface syntax -> Atom / List / Record Core.

currentToken: fn(state: record) = [
    tokens: list = state.tokens,
    tokens@(state.pos)
]

checkToken: fn(state: record, tokenKind: string) = currentToken(state).kind == tokenKind

checkNextToken: fn(state: record, tokenKind: string) = [
    tokens: list = state.tokens,
    position: number = state.pos + 1,
    result: boolean = false,
    if position < tokens.length() then
        result = tokens@position.kind == tokenKind
    end,
    result
]

checkIdentifier: fn(state: record, text: string) = [
    token: record = currentToken(state),
    token.kind == "identifier" and token.text == text
]

advanceToken: fn(state: record) = [
    tokens: list = state.tokens,
    token: record = currentToken(state),
    if state.pos < tokens.length() - 1 then
        state.pos = state.pos + 1
    end,
    token
]

matchToken: fn(state: record, tokenKind: string) = [
    matched: boolean = checkToken(state, tokenKind),
    if matched then
        advanceToken(state)
    end,
    matched
]

matchIdentifier: fn(state: record, text: string) = [
    matched: boolean = checkIdentifier(state, text),
    if matched then
        advanceToken(state)
    end,
    matched
]

consumeToken: fn(state: record, tokenKind: string, message: string) = [
    token: record = currentToken(state),
    if token.kind != tokenKind then
        fail(message + " at " + token.line + ":" + token.column)
    end,
    advanceToken(state)
]

consumeIdentifier: fn(state: record, text: string, message: string) = [
    token: record = currentToken(state),
    if token.kind != "identifier" or token.text != text then
        fail(message + " at " + token.line + ":" + token.column)
    end,
    advanceToken(state)
]

skipNewLines: fn(state: record) = [
    for [more: boolean = checkToken(state, "newline"), more, more = checkToken(state, "newline")]
        advanceToken(state)
    loop,
    null
]

requireNewLine: fn(state: record, message: string) = [
    if not matchToken(state, "newline") then
        token: record = currentToken(state)
        fail(message + " at " + token.line + ":" + token.column)
    end,
    skipNewLines(state)
]

requireStatementBoundary: fn(state: record) = [
    valid: boolean = checkToken(state, "end") or checkToken(state, "rbrace") or checkToken(state, "rbracket") or checkToken(state, "newline"),
    if not valid then
        token: record = currentToken(state)
        fail("Expected newline between expressions at " + token.line + ":" + token.column)
    end,
    null
]

atTerminator: fn(state: record, terminators: list) = [
    found: boolean = false,
    token: record = currentToken(state),
    if token.kind == "identifier" then
        for [i: number = 0, i < terminators.length(), i += 1]
            if token.text == terminators@i then
                found = true
            end
        loop
    end,
    found
]

parseProgram: fn(tokens: list) = [
    state: record = { tokens: tokens, pos: 0 },
    expressions: list = [symbol("do")],
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "end"), tick += 1]
        expressions.push(parseTopLevelStatement(state))
        requireStatementBoundary(state)
        skipNewLines(state)
    loop,

    expressions
]

parseTopLevelStatement: fn(state: record) = [
    result: atom | list | record = null,
    if checkToken(state, "identifier") and checkNextToken(state, "colon") then
        result = parseDeclaration(state, true)
    else
        result = parseStatement(state)
    end,
    result
]

parseStatement: fn(state: record) = [
    result: atom | list | record = null,
    if checkIdentifier(state, "include") then
        result = parseInclude(state)
    else if checkIdentifier(state, "if") then
        result = parseIf(state)
    else if checkIdentifier(state, "when") then
        result = parseWhen(state)
    else if checkIdentifier(state, "for") then
        result = parseFor(state)
    else if matchIdentifier(state, "break") then
        result = [symbol("break")]
    else if matchIdentifier(state, "continue") then
        result = [symbol("continue")]
    else if checkToken(state, "identifier") and checkNextToken(state, "colon") then
        result = parseDeclaration(state, false)
    else
        result = parseExpression(state)
    end,
    result
]

parseInclude: fn(state: record) = [
    consumeIdentifier(state, "include", "Expected 'include'"),
    token: record = currentToken(state),
    spec: record = { kind: "", name: "" },

    if token.kind == "string" then
        advanceToken(state)
        if token.text == "" then
            fail("Local include path cannot be empty")
        end
        spec = { kind: "local", name: token.text }
    else
        first: record = consumeToken(state, "identifier", "Expected quoted local path or named include after 'include'")
        name: string = first.text
        for [more: boolean = matchToken(state, "dot"), more, more = matchToken(state, "dot")]
            part: record = consumeToken(state, "identifier", "Expected name after '.' in include")
            name = name + "." + part.text
        loop
        spec = { kind: "named", name: name }
    end,

    [symbol("include"), spec]
]

buildConditionalChain: fn(conditions: list, bodies: list, fallback: list) = [
    lastIndex: number = conditions.length() - 1,
    result: list = [symbol("if"), conditions@lastIndex, bodies@lastIndex, fallback],

    for [i: number = lastIndex - 1, i >= 0, i = i - 1]
        result = [symbol("if"), conditions@i, bodies@i, [symbol("do"), result]]
    loop,

    result
]

parseIfClauseAfterIf: fn(state: record, conditions: list, bodies: list) = [
    condition: atom | list | record = parseExpression(state),
    consumeIdentifier(state, "then", "Expected 'then' after if condition"),
    requireNewLine(state, "Expected newline after 'then'"),
    conditions.push(condition),
    bodies.push(parseStatementsUntil(state, ["else", "end"])),
    null
]

parseIf: fn(state: record) = [
    consumeIdentifier(state, "if", "Expected 'if'"),
    conditions: list = [],
    bodies: list = [],
    elseBody: list = [symbol("do")],

    parseIfClauseAfterIf(state, conditions, bodies),

    chaining: boolean = true,
    for [tick: number = 0, chaining, tick += 1]
        if matchIdentifier(state, "else") then
            if matchIdentifier(state, "if") then
                parseIfClauseAfterIf(state, conditions, bodies)
            else
                requireNewLine(state, "Expected newline after 'else'")
                elseBody = parseStatementsUntil(state, ["end"])
                chaining = false
            end
        else
            chaining = false
        end
    loop,

    consumeIdentifier(state, "end", "Expected 'end' to close if"),
    buildConditionalChain(conditions, bodies, elseBody)
]

atWhenTerminator: fn(state: record) = [
    result: boolean = false,
    if checkIdentifier(state, "otherwise") then
        result = true
    end,
    if checkIdentifier(state, "end") then
        result = true
    end,
    if checkToken(state, "end") then
        result = true
    end,
    result
]

atWhenClauseStart: fn(state: record) = [
    result: boolean = false,
    if not atWhenTerminator(state) then
        savedPosition: number = state.pos
        parseExpression(state)
        result = checkIdentifier(state, "then")
        state.pos = savedPosition
    end,
    result
]

parseWhenClauseBody: fn(state: record) = [
    items: list = [symbol("do")],
    skipNewLines(state),

    for [tick: number = 0, not atWhenTerminator(state) and not atWhenClauseStart(state), tick += 1]
        items.push(parseStatement(state))
        requireStatementBoundary(state)
        skipNewLines(state)
    loop,

    if items.length() == 1 then
        token: record = currentToken(state)
        fail("Expected expression in when clause at " + token.line + ":" + token.column)
    end,

    items
]

parseWhen: fn(state: record) = [
    consumeIdentifier(state, "when", "Expected 'when'"),
    requireNewLine(state, "Expected newline after 'when'"),
    conditions: list = [],
    bodies: list = [],

    for [tick: number = 0, not atWhenTerminator(state), tick += 1]
        condition: atom | list | record = parseExpression(state)
        consumeIdentifier(state, "then", "Expected 'then' after when condition")
        requireNewLine(state, "Expected newline after 'then'")
        conditions.push(condition)
        bodies.push(parseWhenClauseBody(state))
    loop,

    if conditions.length() == 0 then
        fail("when requires at least one condition")
    end,
    if not matchIdentifier(state, "otherwise") then
        token: record = currentToken(state)
        fail("Expected 'otherwise' in when expression at " + token.line + ":" + token.column)
    end,

    requireNewLine(state, "Expected newline after 'otherwise'"),
    otherwiseBody: list = parseStatementsUntil(state, ["end"]),
    if otherwiseBody.length() == 1 then
        token: record = currentToken(state)
        fail("Expected expression after 'otherwise' at " + token.line + ":" + token.column)
    end,

    consumeIdentifier(state, "end", "Expected 'end' to close when"),
    buildConditionalChain(conditions, bodies, otherwiseBody)
]

parseFor: fn(state: record) = [
    consumeIdentifier(state, "for", "Expected 'for'"),
    consumeToken(state, "lbracket", "Expected '[' after 'for'"),
    initializer: atom | list | record = null,

    if checkToken(state, "identifier") and checkNextToken(state, "colon") then
        initializer = parseDeclaration(state, false)
    else
        initializer = parseExpression(state)
    end,

    consumeToken(state, "comma", "Expected ',' after for initializer"),
    condition: atom | list | record = parseExpression(state),
    consumeToken(state, "comma", "Expected ',' after for condition"),
    step: atom | list | record = parseExpression(state),
    consumeToken(state, "rbracket", "Expected ']' after for header"),
    requireNewLine(state, "Expected newline after for header"),
    body: list = parseStatementsUntil(state, ["loop"]),
    consumeIdentifier(state, "loop", "Expected 'loop' to close for"),
    [symbol("for"), initializer, condition, step, body]
]

parseStatementsUntil: fn(state: record, terminators: list) = [
    items: list = [symbol("do")],
    skipNewLines(state),
    for [tick: number = 0, not checkToken(state, "end") and not atTerminator(state, terminators), tick += 1]
        items.push(parseStatement(state))
        requireStatementBoundary(state)
        skipNewLines(state)
    loop,
    if checkToken(state, "end") then
        fail("Unexpected end of source while parsing block")
    end,
    items
]

parseFunctionMetadataAfterFn: fn(state: record) = [
    metadata: record = {},

    if matchToken(state, "less") then
        if checkToken(state, "greater") then
            token: record = currentToken(state)
            fail("Function metadata cannot be empty at " + token.line + ":" + token.column)
        end

        done: boolean = false
        for [tick: number = 0, not done, tick += 1]
            tag: record = consumeToken(state, "identifier", "Expected function metadata name")
            if tag.text != "private" then
                fail("Unknown function metadata '" + tag.text + "' at " + tag.line + ":" + tag.column)
            end
            if metadata.has(tag.text) then
                fail("Duplicate function metadata '" + tag.text + "' at " + tag.line + ":" + tag.column)
            end
            metadata.set(tag.text, true)

            if matchToken(state, "comma") then
                if checkToken(state, "greater") then
                    token: record = currentToken(state)
                    fail("Expected function metadata name after ',' at " + token.line + ":" + token.column)
                end
            else
                done = true
            end
        loop

        consumeToken(state, "greater", "Expected '>' after function metadata")
    end,

    metadata
]

parseDeclaration: fn(state: record, moduleLevel: boolean) = [
    nameToken: record = consumeToken(state, "identifier", "Expected declaration name"),
    consumeToken(state, "colon", "Expected ':'"),
    result: atom | list | record = null,

    if matchIdentifier(state, "fn") then
        metadata: record = parseFunctionMetadataAfterFn(state)
        if metadata.has("private") and not moduleLevel then
            fail("fn<private> is only valid on module-level named function declarations at " + nameToken.line + ":" + nameToken.column)
        end

        result = [symbol("def"), symbol(nameToken.text), symbol("fn"), parseFunctionDeclarationAfterFn(state)]
        if metadata.has("private") then
            result.push(metadata)
        end
    else if matchIdentifier(state, "type") then
        consumeToken(state, "equal", "Expected '=' after type declaration")
        result = [symbol("def"), symbol(nameToken.text), symbol("type"), parseTypeDefinition(state)]
    else
        typeName: string = parseTypeAnnotation(state)
        consumeToken(state, "equal", "Expected '=' in declaration")
        skipNewLines(state)
        result = [symbol("def"), symbol(nameToken.text), symbol(typeName), parseExpression(state)]
    end,

    result
]

// Type annotations use | for unions, including list<T|U|W>.
parseTypeMember: fn(state: record) = [
    first: record = consumeToken(state, "identifier", "Expected type name"),
    result: string = first.text,
    if result == "any" then
        fail("Beacon has no 'any' type; use an explicit type or union")
    end,
    if matchToken(state, "less") then
        if result != "list" then
            fail("Only list<T|U|W> supports type parameters at " + first.line + ":" + first.column)
        end
        result = "list<" + parseTypeAnnotation(state) + ">"
        consumeToken(state, "greater", "Expected '>' after List element type")
    end,
    result
]

parseTypeAnnotation: fn(state: record) = [
    result: string = parseTypeMember(state),
    for [more: boolean = matchToken(state, "pipe"), more, more = matchToken(state, "pipe")]
        result += "|" + parseTypeMember(state)
    loop,
    result
]

parseFunctionDeclarationAfterFn: fn(state: record) = [
    result: list = [],

    if checkToken(state, "lparen") then
        result = parseFunctionAfterFn(state)
    else
        consumeToken(state, "equal", "Expected '(' or '=' after fn")
        result = parseFunctionClausesAfterEqual(state)
    end,

    result
]

parseFunctionClausesAfterEqual: fn(state: record) = [
    consumeToken(state, "lbracket", "Expected '[' after 'fn ='") ,
    clauses: list = [symbol("list")],
    skipNewLines(state),

    if checkToken(state, "rbracket") then
        fail("Function clause list cannot be empty")
    end,

    done: boolean = false,
    for [tick: number = 0, not done, tick += 1]
        consumeIdentifier(state, "fn", "Expected fn clause")
        if checkToken(state, "less") then
            token: record = currentToken(state)
            fail("Function metadata is only valid on module-level named function declarations at " + token.line + ":" + token.column)
        end
        clauses.push(parseFunctionAfterFn(state))
        skipNewLines(state)

        if matchToken(state, "rbracket") then
            done = true
        else
            consumeToken(state, "comma", "Beacon function clauses require commas between clauses")
            skipNewLines(state)
        end
    loop,

    [symbol("fn"), clauses]
]

parseFunctionAfterFn: fn(state: record) = [
    consumeToken(state, "lparen", "Expected '(' after fn"),
    parameters: list = [],
    skipNewLines(state),

    if not checkToken(state, "rparen") then
        done: boolean = false
        for [tick: number = 0, not done, tick += 1]
            nameToken: record = consumeToken(state, "identifier", "Expected parameter name")
            consumeToken(state, "colon", "Expected ':' after parameter name")
            typeName: string = parseTypeAnnotation(state)
            parameters.push({ name: symbol(nameToken.text), type: symbol(typeName) })
            if matchToken(state, "comma") then
                skipNewLines(state)
            else
                done = true
            end
        loop
    end,

    consumeToken(state, "rparen", "Expected ')' after parameters"),
    consumeToken(state, "equal", "Expected '=' before function body"),
    [symbol("fn"), parameters, parseBody(state)]
]

parseBody: fn(state: record) = [
    skipNewLines(state),
    result: atom | list | record = null,
    if not matchToken(state, "lbracket") then
        result = parseExpression(state)
    else
        items: list = [symbol("do")]
        skipNewLines(state)
        if matchToken(state, "rbracket") then
            result = items
        else
            done: boolean = false
            for [tick: number = 0, not done, tick += 1]
                items.push(parseStatement(state))
                skipNewLines(state)
                if matchToken(state, "rbracket") then
                    done = true
                else
                    consumeToken(state, "comma", "Beacon Lists require commas between elements")
                    skipNewLines(state)
                end
            loop
            result = items
        end
    end,
    result
]

parseTypeDefinition: fn(state: record) = [
    consumeToken(state, "lbrace", "Expected '{' after type ="),
    members: record = {},
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "rbrace"), tick += 1]
        nameToken: record = consumeToken(state, "identifier", "Expected member name")
        consumeToken(state, "colon", "Expected ':' after member name")
        if matchIdentifier(state, "fn") then
            if checkToken(state, "less") then
                token: record = currentToken(state)
                fail("Function metadata is only valid on module-level named function declarations at " + token.line + ":" + token.column)
            end
            members.set(nameToken.text, parseFunctionDeclarationAfterFn(state))
        else
            members.set(nameToken.text, symbol(parseTypeAnnotation(state)))
        end

        if matchToken(state, "comma") then
            skipNewLines(state)
        else if not checkToken(state, "rbrace") then
            requireNewLine(state, "Expected newline or ',' between Record members")
        end
        skipNewLines(state)
    loop,

    consumeToken(state, "rbrace", "Expected '}'"),
    [symbol("type"), members]
]

parseExpression: fn(state: record) = parseAssignment(state)

parseAssignment: fn(state: record) = [
    left: atom | list | record = parseOr(state),
    result: atom | list | record = left,
    if matchToken(state, "pluseq") then
        skipNewLines(state)
        result = [symbol("+="), left, parseAssignment(state)]
    else if matchToken(state, "equal") then
        skipNewLines(state)
        result = [symbol("="), left, parseAssignment(state)]
    end,
    result
]

parseOr: fn(state: record) = [
    expression: atom | list | record = parseAnd(state),
    for [more: boolean = matchIdentifier(state, "or"), more, more = matchIdentifier(state, "or")]
        skipNewLines(state)
        expression = [symbol("or"), expression, parseAnd(state)]
    loop,
    expression
]

parseAnd: fn(state: record) = [
    expression: atom | list | record = parseComparison(state),
    for [more: boolean = matchIdentifier(state, "and"), more, more = matchIdentifier(state, "and")]
        skipNewLines(state)
        expression = [symbol("and"), expression, parseComparison(state)]
    loop,
    expression
]

parseComparison: fn(state: record) = [
    expression: atom | list | record = parseAdditive(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "eqeq") then
            operator = "=="
        else if matchToken(state, "bangeq") then
            operator = "!="
        else if matchToken(state, "less") then
            operator = "<"
        else if matchToken(state, "lesseq") then
            operator = "<="
        else if matchToken(state, "greater") then
            operator = ">"
        else if matchToken(state, "greatereq") then
            operator = ">="
        else
            active = false
        end
        if active then
            skipNewLines(state)
            expression = [symbol(operator), expression, parseAdditive(state)]
        end
    loop,
    expression
]

parseAdditive: fn(state: record) = [
    expression: atom | list | record = parseMultiplicative(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "plus") then
            operator = "+"
        else if matchToken(state, "minus") then
            operator = "-"
        else
            active = false
        end
        if active then
            skipNewLines(state)
            expression = [symbol(operator), expression, parseMultiplicative(state)]
        end
    loop,
    expression
]

parseMultiplicative: fn(state: record) = [
    expression: atom | list | record = parseUnary(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "star") then
            operator = "*"
        else if matchToken(state, "slash") then
            operator = "/"
        else
            active = false
        end
        if active then
            skipNewLines(state)
            expression = [symbol(operator), expression, parseUnary(state)]
        end
    loop,
    expression
]

parseUnary: fn(state: record) = [
    result: atom | list | record = null,
    if matchIdentifier(state, "not") then
        skipNewLines(state)
        result = [symbol("not"), parseUnary(state)]
    else if matchToken(state, "minus") then
        skipNewLines(state)
        result = [symbol("neg"), parseUnary(state)]
    else
        result = parsePostfix(state)
    end,
    result
]

parsePostfix: fn(state: record) = [
    expression: atom | list | record = parsePrimary(state),
    active: boolean = true,

    for [tick: number = 0, active, tick += 1]
        if matchToken(state, "dot") then
            member: record = consumeToken(state, "identifier", "Expected member name after '.'")
            expression = [symbol("get"), expression, member.text]
        else if matchToken(state, "at") then
            skipNewLines(state)
            expression = [symbol("index"), expression, parsePrimary(state)]
        else if matchToken(state, "lparen") then
            call: list = [symbol("call"), expression]
            skipNewLines(state)
            if not checkToken(state, "rparen") then
                done: boolean = false
                for [argIndex: number = 0, not done, argIndex += 1]
                    call.push(parseExpression(state))
                    if matchToken(state, "comma") then
                        skipNewLines(state)
                    else
                        done = true
                    end
                loop
            end
            skipNewLines(state)
            consumeToken(state, "rparen", "Expected ')' after arguments")
            expression = call
        else
            active = false
        end
    loop,

    expression
]

parsePrimary: fn(state: record) = [
    result: atom | list | record = null,
    token: record = currentToken(state),

    if matchToken(state, "number") then
        result = number(token.text)
    else if matchToken(state, "string") then
        result = token.text
    else if checkIdentifier(state, "if") then
        result = parseIf(state)
    else if checkIdentifier(state, "when") then
        result = parseWhen(state)
    else if matchToken(state, "identifier") then
        if token.text == "true" then
            result = true
        else if token.text == "false" then
            result = false
        else if token.text == "null" then
            result = null
        else if matchToken(state, "lbrace") then
            // Explicit anonymous value: item { name: "Potion" }
            result = [symbol("typed"), symbol(token.text), parseRecordLiteralAfterOpen(state)]
        else
            result = symbol(token.text)
        end
    else if matchToken(state, "dot") then
        member: record = consumeToken(state, "identifier", "Expected member after '.'")
        result = [symbol("get"), symbol("self"), member.text]
    else if matchToken(state, "lparen") then
        skipNewLines(state)
        result = parseExpression(state)
        skipNewLines(state)
        consumeToken(state, "rparen", "Expected ')'")
    else if matchToken(state, "lbracket") then
        result = parseListLiteralAfterOpen(state)
    else if matchToken(state, "lbrace") then
        result = parseRecordLiteralAfterOpen(state)
    else
        fail("Expected expression at " + token.line + ":" + token.column)
    end,

    result
]

parseListLiteralAfterOpen: fn(state: record) = [
    items: list = [symbol("list")],
    skipNewLines(state),
    done: boolean = matchToken(state, "rbracket"),

    for [tick: number = 0, not done, tick += 1]
        items.push(parseExpression(state))
        skipNewLines(state)
        if matchToken(state, "rbracket") then
            done = true
        else
            consumeToken(state, "comma", "Beacon Lists require commas between elements")
            skipNewLines(state)
        end
    loop,

    items
]

parseRecordLiteralAfterOpen: fn(state: record) = [
    result: record = {},
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "rbrace"), tick += 1]
        key: record = consumeToken(state, "identifier", "Expected Record field name")
        consumeToken(state, "colon", "Expected ':' after field name")
        result.set(key.text, parseExpression(state))

        if matchToken(state, "comma") then
            skipNewLines(state)
        else if not checkToken(state, "rbrace") then
            requireNewLine(state, "Expected newline or ',' between Record fields")
        end
        skipNewLines(state)
    loop,

    consumeToken(state, "rbrace", "Expected '}'"),
    result
]
