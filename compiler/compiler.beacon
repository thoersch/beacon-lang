// Beacon self-hosted compiler composition root.
//
// Local includes are relative to this file and omit the .beacon extension.
// The compiler itself is intentionally split into reusable compilation units.

include "diagnostics"
include "core"
include "lexer"
include "parser"
include "source-map"
include "typecheck"
include "emitter"

compileSourceResult: fn(source: string) = [
    tokens: list = lex(source),
    program: list = parseProgram(tokens),
    sources: list = [{ file: "<source>", source: source }],
    compileProgramResult(program, sources)
]

compileSource: fn(source: string) = [
    sources: list = [{ file: "<source>", source: source }],
    result: record = compileSourceResult(source),
    requireCompilationPlan(result, sources)
]

compileFileResult: fn(path: string) = [
    program: list = loadProgram(path),
    sources: list = collectSourceFiles(path),
    compileProgramResult(program, sources)
]

compileFile: fn(path: string) = [
    sources: list = collectSourceFiles(path),
    result: record = compileFileResult(path),
    requireCompilationPlan(result, sources)
]
