// Beacon self-hosted compiler composition root.
//
// Local includes are relative to this file and omit the .beacon extension.
// The compiler itself is intentionally split into reusable compilation units.

include "core"
include "lexer"
include "parser"
include "emitter"

compileSource: fn(source: string) = [
    tokens: list = lex(source),
    program: list = parseProgram(tokens),
    compile(program)
]

compileFile: fn(path: string) = compile(loadProgram(path))
