// Beacon self-hosted compiler.
//
// Stage 0 exists only as the seed compiler. Once this file has been compiled
// once, compileSource() performs lexing, parsing, Core construction, and CLR
// plan generation in Beacon itself.

labelCounter: number = 0

nextLabel: fn(prefix: string) = [
    labelCounter += 1,
    prefix + labelCounter
]

isForm: fn(node: atom | list | record, name: string) = [
    result: boolean = false,
    if kind(node) == "list" then
        if node.length() > 0 then
            if kind(node@0) == "symbol" then
                result = node@0.name == name
            end
        end
    end,
    result
]

isStatementForm: fn(node: atom | list | record) = [
    result: boolean = false,
    if isForm(node, "if") or isForm(node, "for") then
        result = true
    end,
    result
]

emitTarget: fn(node: atom | list | record) = [
    result: list = [],
    if kind(node) == "symbol" and node.name == "self" then
        result = [{ op: "ldself" }]
    else
        result = emit(node)
    end,
    result
]

compile: fn(program: list) = [
    labelCounter = 0,
    head: symbol = program@0,
    ops: list = [],

    if head.name != "do" then
        fail("Program Core must begin with do")
    end,

    for [i: number = 1, i < program.length(), i += 1]
        ops = ops.concat(emitStatement(program@i))
    loop,

    ops
]

emitStatement: fn(node: atom | list | record) = [
    result: list = [],
    if isForm(node, "if") then
        result = emitIf(node)
    else
        if isForm(node, "for") then
            result = emitFor(node)
        else
            result = emit(node)
            result.append({ op: "pop" })
        end
    end,
    result
]

emitDoStatements: fn(body: list) = [
    ops: list = [],
    for [i: number = 1, i < body.length(), i += 1]
        ops = ops.concat(emitStatement(body@i))
    loop,
    ops
]

emitFunctionBody: fn(body: atom | list | record) = [
    ops: list = [],
    if isForm(body, "do") then
        if body.length() == 1 then
            ops.append({ op: "ldnull" })
        else
            for [i: number = 1, i < body.length() - 1, i += 1]
                ops = ops.concat(emitStatement(body@i))
            loop
            last: atom | list | record = body@(body.length() - 1)
            if isStatementForm(last) then
                ops = ops.concat(emitStatement(last))
                ops.append({ op: "ldnull" })
            else
                ops = ops.concat(emit(last))
            end
        end
    else
        ops = emit(body)
    end,
    ops
]

emit: fn(node: atom | list | record) = [
    nodeKind: string = kind(node),
    result: list = [],

    if nodeKind == "list" then
        result = emitForm(node)
    else
        if nodeKind == "record" then
            result = emitRecord(node)
        else
            result = emitAtom(node)
        end
    end,

    result
]

emitAtom: fn(node: atom) = [
    nodeKind: string = kind(node),
    result: list = [],

    if nodeKind == "number" then
        result = [
            { op: "ldc.r8", arg: node },
            { op: "box", arg: "number" }
        ]
    else
        if nodeKind == "string" then
            result = [
                { op: "interpolate", text: node }
            ]
        else
            if nodeKind == "boolean" then
                result = [
                    { op: "ldbool", arg: node },
                    { op: "box", arg: "boolean" }
                ]
            else
                if nodeKind == "null" then
                    result = [{ op: "ldnull" }]
                else
                    if nodeKind == "symbol" then
                        if node.name == "self" then
                            result = [{ op: "ldself" }]
                        else
                            result = [
                                { op: "ldenv" },
                                { op: "ldstr", arg: node.name },
                                { op: "call", arg: "Runtime.GetVar" }
                            ]
                        end
                    else
                        fail("Unsupported Atom kind: {nodeKind}")
                    end
                end
            end
        end
    end,

    result
]

emitRecord: fn(node: record) = [
    keys: list = node.keys(),
    fields: list = [],

    for [i: number = 0, i < keys.length(), i += 1]
        key: string = keys@i
        fields.append({
            name: key,
            value: emit(node@key)
        })
    loop,

    [{ op: "record", fields: fields }]
]

emitForm: fn(node: list) = [
    head: symbol = node@0,
    form: string = head.name,
    result: list = [],
    handled: boolean = false,

    if form == "+" then
        result = emitBinary(node, "Runtime.Add")
        handled = true
    end,
    if form == "-" then
        result = emitBinary(node, "Runtime.Sub")
        handled = true
    end,
    if form == "*" then
        result = emitBinary(node, "Runtime.Mul")
        handled = true
    end,
    if form == "/" then
        result = emitBinary(node, "Runtime.Div")
        handled = true
    end,
    if form == "==" then
        result = emitEquality(node)
        handled = true
    end,
    if form == "!=" then
        result = emitNotEqual(node)
        handled = true
    end,
    if form == "<" or form == "<=" or form == ">" or form == ">=" then
        result = emitComparison(node, form)
        handled = true
    end,
    if form == "and" then
        result = emitLogicalAnd(node)
        handled = true
    end,
    if form == "or" then
        result = emitLogicalOr(node)
        handled = true
    end,
    if form == "not" then
        result = emitLogicalNot(node)
        handled = true
    end,
    if form == "list" then
        result = emitList(node)
        handled = true
    end,
    if form == "get" then
        result = emitGet(node)
        handled = true
    end,
    if form == "index" then
        result = emitIndex(node)
        handled = true
    end,
    if form == "def" then
        result = emitDefinition(node)
        handled = true
    end,
    if form == "=" then
        result = emitAssign(node)
        handled = true
    end,
    if form == "+=" then
        result = emitPlusAssign(node)
        handled = true
    end,
    if form == "call" then
        result = emitCall(node)
        handled = true
    end,
    if form == "fn" then
        result = emitFunction(node)
        handled = true
    end,
    if form == "type" then
        fail("type Core is emitted through its declaration")
    end,

    if not handled then
        fail("Self-hosted compiler does not emit Core form: {form}")
    end,

    result
]

emitBinary: fn(node: list, runtimeMethod: string) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: runtimeMethod }),
    ops
]

emitEquality: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Equal" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitNotEqual: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Equal" }),
    ops.append({ op: "not.bool" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitComparison: fn(node: list, operator: string) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "ldstr", arg: operator }),
    ops.append({ op: "call", arg: "Runtime.Compare" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalAnd: fn(node: list) = [
    falseLabel: string = nextLabel("and_false_"),
    endLabel: string = nextLabel("and_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: falseLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: falseLabel }),
    ops.append({ op: "ldbool", arg: false }),
    ops.append({ op: "label", name: endLabel }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalOr: fn(node: list) = [
    trueLabel: string = nextLabel("or_true_"),
    endLabel: string = nextLabel("or_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brtrue", label: trueLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: trueLabel }),
    ops.append({ op: "ldbool", arg: true }),
    ops.append({ op: "label", name: endLabel }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitLogicalNot: fn(node: list) = [
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "not.bool" }),
    ops.append({ op: "box", arg: "boolean" }),
    ops
]

emitList: fn(node: list) = [
    items: list = [],
    for [i: number = 1, i < node.length(), i += 1]
        items.append(emit(node@i))
    loop,
    [{ op: "list", items: items }]
]

emitGet: fn(node: list) = [
    ops: list = emitTarget(node@1),
    member: string = node@2,
    ops.append({ op: "ldstr", arg: member }),
    ops.append({ op: "call", arg: "Runtime.Get" }),
    ops
]

emitIndex: fn(node: list) = [
    ops: list = emit(node@1),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Index" }),
    ops
]

emitDefinition: fn(node: list) = [
    name: symbol = node@1,
    declaredType: symbol = node@2,
    valuePlan: list = [],

    if declaredType.name == "type" then
        valuePlan = emitType(name.name, node@3)
    else
        valuePlan = emit(node@3)
    end,

    ops: list = [
        { op: "ldenv" },
        { op: "ldstr", arg: name.name },
        { op: "ldstr", arg: declaredType.name }
    ],
    ops = ops.concat(valuePlan),
    ops.append({ op: "call", arg: "Runtime.Declare" }),
    ops
]

emitAssign: fn(node: list) = [
    target: atom | list | record = node@1,
    value: atom | list | record = node@2,
    result: list = [],

    if kind(target) == "symbol" then
        result = [
            { op: "ldenv" },
            { op: "ldstr", arg: target.name }
        ]
        result = result.concat(emit(value))
        result.append({ op: "call", arg: "Runtime.SetVar" })
    else
        if isForm(target, "get") then
            result = emitTarget(target@1)
            result.append({ op: "ldstr", arg: target@2 })
            result = result.concat(emit(value))
            result.append({ op: "call", arg: "Runtime.SetMember" })
        else
            if isForm(target, "index") then
                result = emit(target@1)
                result = result.concat(emit(target@2))
                result = result.concat(emit(value))
                result.append({ op: "call", arg: "Runtime.SetIndex" })
            else
                fail("Left side of = must be a variable, member, or indexed value")
            end
        end
    end,

    result
]

emitPlusAssign: fn(node: list) = [
    target: atom | list | record = node@1,
    value: atom | list | record = node@2,
    result: list = [],

    if kind(target) == "symbol" then
        result = [
            { op: "ldenv" },
            { op: "ldstr", arg: target.name }
        ]
        result = result.concat(emit(value))
        result.append({ op: "call", arg: "Runtime.AddAssignVar" })
    else
        if isForm(target, "get") then
            result = emitTarget(target@1)
            result.append({ op: "ldstr", arg: target@2 })
            result = result.concat(emit(value))
            result.append({ op: "call", arg: "Runtime.AddAssignMember" })
        else
            fail("Left side of += must be a variable or member")
        end
    end,

    result
]

emitCall: fn(node: list) = [
    callee: atom | list | record = node@1,
    args: list = [],
    result: list = [],

    for [i: number = 2, i < node.length(), i += 1]
        args.append(emit(node@i))
    loop,

    if kind(callee) == "symbol" and callee.name == "print" then
        result = [{ op: "print", args: args }]
    else
        if kind(callee) == "symbol" and callee.name == "kind" then
            result = args@0
            result.append({ op: "call", arg: "Runtime.Kind" })
        else
            if kind(callee) == "symbol" and callee.name == "fail" then
                result = args@0
                result.append({ op: "call", arg: "Runtime.Fail" })
            else
                if kind(callee) == "symbol" and callee.name == "symbol" then
                    result = args@0
                    result.append({ op: "call", arg: "Runtime.Symbol" })
                else
                    if kind(callee) == "symbol" and callee.name == "number" then
                        result = args@0
                        result.append({ op: "call", arg: "Runtime.Number" })
                        result.append({ op: "box", arg: "number" })
                    else
                        if isForm(callee, "get") then
                            result = [{
                                op: "invoke.member",
                                receiver: emitTarget(callee@1),
                                member: callee@2,
                                args: args
                            }]
                        else
                            result = [{
                                op: "invoke",
                                callee: emit(callee),
                                args: args
                            }]
                        end
                    end
                end
            end
        end
    end,

    result
]

emitFunction: fn(node: list) = [
    rawParams: list = node@1,
    params: list = [],

    for [i: number = 0, i < rawParams.length(), i += 1]
        parameter: record = rawParams@i
        paramName: symbol = parameter@"name"
        paramType: symbol = parameter@"type"
        params.append({ name: paramName.name, type: paramType.name })
    loop,

    [{
        op: "fn",
        params: params,
        body: emitFunctionBody(node@2)
    }]
]

emitType: fn(typeName: string, node: list) = [
    members: record = node@1,
    keys: list = members.keys(),
    fields: list = [],
    methods: list = [],

    for [i: number = 0, i < keys.length(), i += 1]
        key: string = keys@i
        member: atom | list | record = members@key
        if kind(member) == "symbol" then
            fields.append({ name: key, type: member.name })
        else
            if isForm(member, "fn") then
                methods.append({ name: key, value: emit(member) })
            else
                fail("Unsupported type member: {key}")
            end
        end
    loop,

    [{ op: "type", name: typeName, fields: fields, methods: methods }]
]

emitIf: fn(node: list) = [
    elseLabel: string = nextLabel("if_else_"),
    endLabel: string = nextLabel("if_end_"),
    ops: list = emit(node@1),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: elseLabel }),
    ops = ops.concat(emitDoStatements(node@2)),
    ops.append({ op: "br", label: endLabel }),
    ops.append({ op: "label", name: elseLabel }),
    ops = ops.concat(emitDoStatements(node@3)),
    ops.append({ op: "label", name: endLabel }),
    ops
]

emitFor: fn(node: list) = [
    conditionLabel: string = nextLabel("for_condition_"),
    endLabel: string = nextLabel("for_end_"),
    ops: list = emitStatement(node@1),
    ops.append({ op: "label", name: conditionLabel }),
    ops = ops.concat(emit(node@2)),
    ops.append({ op: "call", arg: "Runtime.Bool" }),
    ops.append({ op: "brfalse", label: endLabel }),
    ops = ops.concat(emitDoStatements(node@4)),
    ops = ops.concat(emit(node@3)),
    ops.append({ op: "pop" }),
    ops.append({ op: "br", label: conditionLabel }),
    ops.append({ op: "label", name: endLabel }),
    ops
]

// --------------------------------------------------------------------------
// Self-hosted reader
// --------------------------------------------------------------------------

letters: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
digits: string = "0123456789"
identifierCharacters: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789"

punctuationTable: list = [
    { char: ":", kind: "colon" },
    { char: "+", kind: "plus" },
    { char: "-", kind: "minus" },
    { char: "*", kind: "star" },
    { char: "/", kind: "slash" },
    { char: "<", kind: "less" },
    { char: ">", kind: "greater" },
    { char: "@", kind: "at" },
    { char: "|", kind: "pipe" },
    { char: "(", kind: "lparen" },
    { char: ")", kind: "rparen" },
    { char: "[", kind: "lbracket" },
    { char: "]", kind: "rbracket" },
    { char: "{", kind: "lbrace" },
    { char: "}", kind: "rbrace" },
    { char: ".", kind: "dot" },
    { char: ",", kind: "comma" },
    { char: "=", kind: "equal" }
]

makeToken: fn(tokenKind: string, tokenText: string, tokenLine: number, tokenColumn: number) = {
    kind: tokenKind
    text: tokenText
    line: tokenLine
    column: tokenColumn
}

peek: fn(source: string, index: number) = [
    result: string = "",
    if index >= 0 and index < source.length() then
        result = source@index
    end,
    result
]

containsCharacter: fn(characters: string, character: string) = [
    found: boolean = false,
    for [i: number = 0, i < characters.length(), i += 1]
        if characters@i == character then
            found = true
        end
    loop,
    found
]

isIdentifierStart: fn(character: string) = containsCharacter(letters, character)
isIdentifierPart: fn(character: string) = containsCharacter(identifierCharacters, character)
isDigit: fn(character: string) = containsCharacter(digits, character)

punctuationAt: fn(source: string, index: number) = [
    character: string = peek(source, index),
    next: string = peek(source, index + 1),
    pair: string = character + next,
    result: record = { matched: false, kind: "", text: "", width: 0 },

    if pair == "==" then
        result = { matched: true, kind: "eqeq", text: "==", width: 2 }
    else
        if pair == "!=" then
            result = { matched: true, kind: "bangeq", text: "!=", width: 2 }
        else
            if pair == "+=" then
                result = { matched: true, kind: "pluseq", text: "+=", width: 2 }
            else
                if pair == "<=" then
                    result = { matched: true, kind: "lesseq", text: "<=", width: 2 }
                else
                    if pair == ">=" then
                        result = { matched: true, kind: "greatereq", text: ">=", width: 2 }
                    end
                end
            end
        end
    end,

    if not result@"matched" then
        for [i: number = 0, i < punctuationTable.length(), i += 1]
            entry: record = punctuationTable@i
            if entry@"char" == character then
                result = { matched: true, kind: entry@"kind", text: character, width: 1 }
            end
        loop
    end,

    result
]

lex: fn(source: string) = [
    tokens: list = [],
    index: number = 0,
    line: number = 1,
    column: number = 1,

    for [tick: number = 0, index < source.length(), tick += 1]
        character: string = peek(source, index)

        if character == " " or character == "\t" then
            index += 1
            column += 1
        else
            if character == "\r" and peek(source, index + 1) == "\n" then
                index += 1
                column += 1
            else
                if character == "\n" then
                tokens.append(makeToken("newline", "\n", line, column))
                index += 1
                line += 1
                column = 1
            else
                if character == "/" and peek(source, index + 1) == "/" then
                    for [scan: number = index, index < source.length() and peek(source, index) != "\n", scan += 1]
                        index += 1
                        column += 1
                    loop
                else
                    if isIdentifierStart(character) then
                        start: number = index
                        startColumn: number = column
                        for [scan: number = index, index < source.length() and isIdentifierPart(peek(source, index)), scan += 1]
                            index += 1
                            column += 1
                        loop
                        tokens.append(makeToken("identifier", source.slice(start, index - start), line, startColumn))
                    else
                        if isDigit(character) then
                            numberStart: number = index
                            numberColumn: number = column
                            for [scan: number = index, index < source.length() and isDigit(peek(source, index)), scan += 1]
                                index += 1
                                column += 1
                            loop
                            if peek(source, index) == "." and isDigit(peek(source, index + 1)) then
                                index += 1
                                column += 1
                                for [decimalScan: number = index, index < source.length() and isDigit(peek(source, index)), decimalScan += 1]
                                    index += 1
                                    column += 1
                                loop
                            end
                            tokens.append(makeToken("number", source.slice(numberStart, index - numberStart), line, numberColumn))
                        else
                            if character == "\"" then
                                stringLine: number = line
                                stringColumn: number = column
                                text: string = ""
                                closed: boolean = false
                                index += 1
                                column += 1

                                for [scan: number = 0, index < source.length() and not closed, scan += 1]
                                    currentCharacter: string = peek(source, index)
                                    if currentCharacter == "\"" then
                                        closed = true
                                        index += 1
                                        column += 1
                                    else
                                        if currentCharacter == "\\" then
                                            escaped: string = peek(source, index + 1)
                                            if escaped == "n" then
                                                text = text + "\n"
                                            else
                                                if escaped == "r" then
                                                    text = text + "\r"
                                                else
                                                    if escaped == "t" then
                                                        text = text + "\t"
                                                    else
                                                        if escaped == "\"" then
                                                            text = text + "\""
                                                        else
                                                            if escaped == "\\" then
                                                                text = text + "\\"
                                                            else
                                                                text = text + escaped
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                            index += 2
                                            column += 2
                                        else
                                            text = text + currentCharacter
                                            if currentCharacter == "\n" then
                                                line += 1
                                                column = 1
                                            else
                                                column += 1
                                            end
                                            index += 1
                                        end
                                    end
                                loop

                                if not closed then
                                    fail("Unterminated string at {stringLine}:{stringColumn}")
                                end
                                tokens.append(makeToken("string", text, stringLine, stringColumn))
                            else
                                punctuation: record = punctuationAt(source, index)
                                if punctuation@"matched" then
                                    tokens.append(makeToken(punctuation@"kind", punctuation@"text", line, column))
                                    index += punctuation@"width"
                                    column += punctuation@"width"
                                else
                                    fail("Unexpected character at {line}:{column}")
                                end
                            end
                        end
                    end
                end
            end
        end
        end
    loop,

    tokens.append(makeToken("end", "", line, column)),
    tokens
]

currentToken: fn(state: record) = [
    tokens: list = state@"tokens",
    tokens@(state@"pos")
]

checkToken: fn(state: record, tokenKind: string) = currentToken(state)@"kind" == tokenKind

checkNextToken: fn(state: record, tokenKind: string) = [
    tokens: list = state@"tokens",
    position: number = state@"pos" + 1,
    result: boolean = false,
    if position < tokens.length() then
        result = tokens@position@"kind" == tokenKind
    end,
    result
]

checkIdentifier: fn(state: record, text: string) = [
    token: record = currentToken(state),
    token@"kind" == "identifier" and token@"text" == text
]

advanceToken: fn(state: record) = [
    tokens: list = state@"tokens",
    token: record = currentToken(state),
    if state@"pos" < tokens.length() - 1 then
        state@"pos" = state@"pos" + 1
    end,
    token
]

matchToken: fn(state: record, tokenKind: string) = [
    matched: boolean = checkToken(state, tokenKind),
    if matched then
        advanceToken(state)
    end,
    matched
]

matchIdentifier: fn(state: record, text: string) = [
    matched: boolean = checkIdentifier(state, text),
    if matched then
        advanceToken(state)
    end,
    matched
]

consumeToken: fn(state: record, tokenKind: string, message: string) = [
    token: record = currentToken(state),
    if token@"kind" != tokenKind then
        fail(message + " at " + token@"line" + ":" + token@"column")
    end,
    advanceToken(state)
]

consumeIdentifier: fn(state: record, text: string, message: string) = [
    token: record = currentToken(state),
    if token@"kind" != "identifier" or token@"text" != text then
        fail(message + " at " + token@"line" + ":" + token@"column")
    end,
    advanceToken(state)
]

skipNewLines: fn(state: record) = [
    for [more: boolean = checkToken(state, "newline"), more, more = checkToken(state, "newline")]
        advanceToken(state)
    loop,
    null
]

requireNewLine: fn(state: record, message: string) = [
    if not matchToken(state, "newline") then
        token: record = currentToken(state)
        fail(message + " at " + token@"line" + ":" + token@"column")
    end,
    skipNewLines(state)
]

requireStatementBoundary: fn(state: record) = [
    valid: boolean = checkToken(state, "end") or checkToken(state, "rbrace") or checkToken(state, "rbracket") or checkToken(state, "newline"),
    if not valid then
        token: record = currentToken(state)
        fail("Expected newline between expressions at " + token@"line" + ":" + token@"column")
    end,
    null
]

atTerminator: fn(state: record, terminators: list) = [
    found: boolean = false,
    token: record = currentToken(state),
    if token@"kind" == "identifier" then
        for [i: number = 0, i < terminators.length(), i += 1]
            if token@"text" == terminators@i then
                found = true
            end
        loop
    end,
    found
]

parseProgram: fn(tokens: list) = [
    state: record = { tokens: tokens, pos: 0 },
    expressions: list = [symbol("do")],
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "end"), tick += 1]
        expressions.append(parseStatement(state))
        requireStatementBoundary(state)
        skipNewLines(state)
    loop,

    expressions
]

parseStatement: fn(state: record) = [
    result: atom | list | record = null,
    if checkIdentifier(state, "if") then
        result = parseIf(state)
    else
        if checkIdentifier(state, "for") then
            result = parseFor(state)
        else
            if checkToken(state, "identifier") and checkNextToken(state, "colon") then
                result = parseDeclaration(state)
            else
                result = parseExpression(state)
            end
        end
    end,
    result
]

parseIf: fn(state: record) = [
    consumeIdentifier(state, "if", "Expected 'if'"),
    condition: atom | list | record = parseExpression(state),
    consumeIdentifier(state, "then", "Expected 'then' after if condition"),
    requireNewLine(state, "Expected newline after 'then'"),
    thenBody: list = parseStatementsUntil(state, ["else", "end"]),
    elseBody: list = [symbol("do")],

    if matchIdentifier(state, "else") then
        requireNewLine(state, "Expected newline after 'else'")
        elseBody = parseStatementsUntil(state, ["end"])
    end,

    consumeIdentifier(state, "end", "Expected 'end' to close if"),
    [symbol("if"), condition, thenBody, elseBody]
]

parseFor: fn(state: record) = [
    consumeIdentifier(state, "for", "Expected 'for'"),
    consumeToken(state, "lbracket", "Expected '[' after 'for'"),
    initializer: atom | list | record = null,

    if checkToken(state, "identifier") and checkNextToken(state, "colon") then
        initializer = parseDeclaration(state)
    else
        initializer = parseExpression(state)
    end,

    consumeToken(state, "comma", "Expected ',' after for initializer"),
    condition: atom | list | record = parseExpression(state),
    consumeToken(state, "comma", "Expected ',' after for condition"),
    step: atom | list | record = parseExpression(state),
    consumeToken(state, "rbracket", "Expected ']' after for header"),
    requireNewLine(state, "Expected newline after for header"),
    body: list = parseStatementsUntil(state, ["loop"]),
    consumeIdentifier(state, "loop", "Expected 'loop' to close for"),
    [symbol("for"), initializer, condition, step, body]
]

parseStatementsUntil: fn(state: record, terminators: list) = [
    items: list = [symbol("do")],
    skipNewLines(state),
    for [tick: number = 0, not checkToken(state, "end") and not atTerminator(state, terminators), tick += 1]
        items.append(parseStatement(state))
        requireStatementBoundary(state)
        skipNewLines(state)
    loop,
    if checkToken(state, "end") then
        fail("Unexpected end of source while parsing block")
    end,
    items
]

parseDeclaration: fn(state: record) = [
    nameToken: record = consumeToken(state, "identifier", "Expected declaration name"),
    consumeToken(state, "colon", "Expected ':'"),
    result: atom | list | record = null,

    if matchIdentifier(state, "fn") then
        result = [symbol("def"), symbol(nameToken@"text"), symbol("fn"), parseFunctionAfterFn(state)]
    else
        if matchIdentifier(state, "type") then
            consumeToken(state, "equal", "Expected '=' after type declaration")
            result = [symbol("def"), symbol(nameToken@"text"), symbol("type"), parseTypeDefinition(state)]
        else
            typeName: string = parseTypeAnnotation(state)
            consumeToken(state, "equal", "Expected '=' in declaration")
            result = [symbol("def"), symbol(nameToken@"text"), symbol(typeName), parseExpression(state)]
        end
    end,

    result
]

parseTypeAnnotation: fn(state: record) = [
    first: record = consumeToken(state, "identifier", "Expected type name"),
    result: string = first@"text",
    if result == "any" then
        fail("Beacon has no 'any' type; use an explicit type or union")
    end,

    for [more: boolean = matchToken(state, "pipe"), more, more = matchToken(state, "pipe")]
        nextType: record = consumeToken(state, "identifier", "Expected type name after '|'")
        if nextType@"text" == "any" then
            fail("Beacon has no 'any' type; use an explicit type or union")
        end
        result = result + "|" + nextType@"text"
    loop,

    result
]

parseFunctionAfterFn: fn(state: record) = [
    consumeToken(state, "lparen", "Expected '(' after fn"),
    parameters: list = [],
    skipNewLines(state),

    if not checkToken(state, "rparen") then
        done: boolean = false
        for [tick: number = 0, not done, tick += 1]
            nameToken: record = consumeToken(state, "identifier", "Expected parameter name")
            consumeToken(state, "colon", "Expected ':' after parameter name")
            typeName: string = parseTypeAnnotation(state)
            parameters.append({ name: symbol(nameToken@"text"), type: symbol(typeName) })
            if matchToken(state, "comma") then
                skipNewLines(state)
            else
                done = true
            end
        loop
    end,

    consumeToken(state, "rparen", "Expected ')' after parameters"),
    consumeToken(state, "equal", "Expected '=' before function body"),
    [symbol("fn"), parameters, parseBody(state)]
]

parseBody: fn(state: record) = [
    skipNewLines(state),
    result: atom | list | record = null,
    if not matchToken(state, "lbracket") then
        result = parseExpression(state)
    else
        items: list = [symbol("do")]
        skipNewLines(state)
        if matchToken(state, "rbracket") then
            result = items
        else
            done: boolean = false
            for [tick: number = 0, not done, tick += 1]
                items.append(parseStatement(state))
                skipNewLines(state)
                if matchToken(state, "rbracket") then
                    done = true
                else
                    consumeToken(state, "comma", "Beacon Lists require commas between elements")
                    skipNewLines(state)
                end
            loop
            result = items
        end
    end,
    result
]

parseTypeDefinition: fn(state: record) = [
    consumeToken(state, "lbrace", "Expected '{' after type ="),
    members: record = {},
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "rbrace"), tick += 1]
        nameToken: record = consumeToken(state, "identifier", "Expected member name")
        consumeToken(state, "colon", "Expected ':' after member name")
        if matchIdentifier(state, "fn") then
            members@(nameToken@"text") = parseFunctionAfterFn(state)
        else
            members@(nameToken@"text") = symbol(parseTypeAnnotation(state))
        end

        if matchToken(state, "comma") then
            skipNewLines(state)
        else
            if not checkToken(state, "rbrace") then
                requireNewLine(state, "Expected newline or ',' between Record members")
            end
        end
        skipNewLines(state)
    loop,

    consumeToken(state, "rbrace", "Expected '}'"),
    [symbol("type"), members]
]

parseExpression: fn(state: record) = parseAssignment(state)

parseAssignment: fn(state: record) = [
    left: atom | list | record = parseOr(state),
    result: atom | list | record = left,
    if matchToken(state, "pluseq") then
        result = [symbol("+="), left, parseAssignment(state)]
    else
        if matchToken(state, "equal") then
            result = [symbol("="), left, parseAssignment(state)]
        end
    end,
    result
]

parseOr: fn(state: record) = [
    expression: atom | list | record = parseAnd(state),
    for [more: boolean = matchIdentifier(state, "or"), more, more = matchIdentifier(state, "or")]
        expression = [symbol("or"), expression, parseAnd(state)]
    loop,
    expression
]

parseAnd: fn(state: record) = [
    expression: atom | list | record = parseComparison(state),
    for [more: boolean = matchIdentifier(state, "and"), more, more = matchIdentifier(state, "and")]
        expression = [symbol("and"), expression, parseComparison(state)]
    loop,
    expression
]

parseComparison: fn(state: record) = [
    expression: atom | list | record = parseAdditive(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "eqeq") then
            operator = "=="
        else
            if matchToken(state, "bangeq") then
                operator = "!="
            else
                if matchToken(state, "less") then
                    operator = "<"
                else
                    if matchToken(state, "lesseq") then
                        operator = "<="
                    else
                        if matchToken(state, "greater") then
                            operator = ">"
                        else
                            if matchToken(state, "greatereq") then
                                operator = ">="
                            else
                                active = false
                            end
                        end
                    end
                end
            end
        end
        if active then
            expression = [symbol(operator), expression, parseAdditive(state)]
        end
    loop,
    expression
]

parseAdditive: fn(state: record) = [
    expression: atom | list | record = parseMultiplicative(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "plus") then
            operator = "+"
        else
            if matchToken(state, "minus") then
                operator = "-"
            else
                active = false
            end
        end
        if active then
            expression = [symbol(operator), expression, parseMultiplicative(state)]
        end
    loop,
    expression
]

parseMultiplicative: fn(state: record) = [
    expression: atom | list | record = parseUnary(state),
    active: boolean = true,
    for [tick: number = 0, active, tick += 1]
        operator: string = ""
        if matchToken(state, "star") then
            operator = "*"
        else
            if matchToken(state, "slash") then
                operator = "/"
            else
                active = false
            end
        end
        if active then
            expression = [symbol(operator), expression, parseUnary(state)]
        end
    loop,
    expression
]

parseUnary: fn(state: record) = [
    result: atom | list | record = null,
    if matchIdentifier(state, "not") then
        result = [symbol("not"), parseUnary(state)]
    else
        result = parsePostfix(state)
    end,
    result
]

parsePostfix: fn(state: record) = [
    expression: atom | list | record = parsePrimary(state),
    active: boolean = true,

    for [tick: number = 0, active, tick += 1]
        if matchToken(state, "dot") then
            member: record = consumeToken(state, "identifier", "Expected member name after '.'")
            expression = [symbol("get"), expression, member@"text"]
        else
            if matchToken(state, "at") then
                expression = [symbol("index"), expression, parsePrimary(state)]
            else
                if matchToken(state, "lparen") then
                    call: list = [symbol("call"), expression]
                    skipNewLines(state)
                    if not checkToken(state, "rparen") then
                        done: boolean = false
                        for [argIndex: number = 0, not done, argIndex += 1]
                            call.append(parseExpression(state))
                            if matchToken(state, "comma") then
                                skipNewLines(state)
                            else
                                done = true
                            end
                        loop
                    end
                    consumeToken(state, "rparen", "Expected ')' after arguments")
                    expression = call
                else
                    active = false
                end
            end
        end
    loop,

    expression
]

parsePrimary: fn(state: record) = [
    result: atom | list | record = null,
    token: record = currentToken(state),

    if matchToken(state, "number") then
        result = number(token@"text")
    else
        if matchToken(state, "string") then
            result = token@"text"
        else
            if matchToken(state, "identifier") then
                if token@"text" == "true" then
                    result = true
                else
                    if token@"text" == "false" then
                        result = false
                    else
                        if token@"text" == "null" then
                            result = null
                        else
                            result = symbol(token@"text")
                        end
                    end
                end
            else
                if matchToken(state, "dot") then
                    member: record = consumeToken(state, "identifier", "Expected member after '.'")
                    result = [symbol("get"), symbol("self"), member@"text"]
                else
                    if matchToken(state, "lparen") then
                        result = parseExpression(state)
                        consumeToken(state, "rparen", "Expected ')'")
                    else
                        if matchToken(state, "lbracket") then
                            result = parseListLiteralAfterOpen(state)
                        else
                            if matchToken(state, "lbrace") then
                                result = parseRecordLiteralAfterOpen(state)
                            else
                                fail("Expected expression at " + token@"line" + ":" + token@"column")
                            end
                        end
                    end
                end
            end
        end
    end,

    result
]

parseListLiteralAfterOpen: fn(state: record) = [
    items: list = [symbol("list")],
    skipNewLines(state),
    done: boolean = matchToken(state, "rbracket"),

    for [tick: number = 0, not done, tick += 1]
        items.append(parseExpression(state))
        skipNewLines(state)
        if matchToken(state, "rbracket") then
            done = true
        else
            consumeToken(state, "comma", "Beacon Lists require commas between elements")
            skipNewLines(state)
        end
    loop,

    items
]

parseRecordLiteralAfterOpen: fn(state: record) = [
    result: record = {},
    skipNewLines(state),

    for [tick: number = 0, not checkToken(state, "rbrace"), tick += 1]
        key: record = consumeToken(state, "identifier", "Expected Record field name")
        consumeToken(state, "colon", "Expected ':' after field name")
        result@(key@"text") = parseExpression(state)

        if matchToken(state, "comma") then
            skipNewLines(state)
        else
            if not checkToken(state, "rbrace") then
                requireNewLine(state, "Expected newline or ',' between Record fields")
            end
        end
        skipNewLines(state)
    loop,

    consumeToken(state, "rbrace", "Expected '}'"),
    result
]

compileSource: fn(source: string) = [
    tokens: list = lex(source),
    program: list = parseProgram(tokens),
    compile(program)
]
