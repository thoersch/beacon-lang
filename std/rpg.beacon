// A portable, deterministic dungeon RPG rules engine. The player data model
// grows out of examples/rpg-typed-inventory.beacon; rendering is a separate concern.
item: type = {
    name: string
    description: string
    quantity: number
}

weapon: type = {
    name: string
    damage: number
}

hero: type = {
    name: string
    level: number
    experience: number
    experienceToLevel: number
    health: number
    maxHealth: number
    power: number
    x: number
    y: number
    gold: number
    inventory: list<item|weapon>
    achievements: list<list<string>>
}

create: fn() = {
    player: hero {
        name: "Jon"
        level: 1
        experience: 0
        experienceToLevel: 3
        health: 18
        maxHealth: 18
        power: 2
        x: 1
        y: 1
        gold: 0
        inventory: [
            item { name: "Potion", description: "Restores six health", quantity: 3 },
            weapon { name: "Iron axe", damage: 2 }
        ]
        achievements: [["Entered the Crypt"]]
    }
    enemies: [
        { x: 5, y: 2, health: 5, power: 2, alive: true, name: "SLIME" },
        { x: 10, y: 4, health: 6, power: 2, alive: true, name: "SHADE" },
        { x: 6, y: 8, health: 7, power: 3, alive: true, name: "GOLEM" },
        { x: 13, y: 9, health: 12, power: 3, alive: true, name: "WARDEN" }
    ]
    kills: 0
    turn: 0
    finished: false
    won: false
    message: "FIND THE GATE. DEFEAT THE WARDEN."
}

width: number = 16
height: number = 12
exitX: number = 14
exitY: number = 10

wall: fn(x: number, y: number) = [
    blocked: boolean = x < 1 or y < 1 or x >= width - 1 or y >= height - 1,
    if y == 4 and x >= 2 and x <= 7 and x != 4 then
        blocked = true
    end,
    if y == 7 and x >= 8 and x <= 13 and x != 11 then
        blocked = true
    end,
    if x == 8 and y >= 2 and y <= 5 and y != 3 then
        blocked = true
    end,
    blocked
]

enemyAt: fn(game: record, x: number, y: number) = [
    found: number = -1,
    for [i: number = 0, i < game.enemies.length(), i += 1]
        foe: record = game.enemies@i
        if foe.alive and foe.x == x and foe.y == y then
            found = i
        end
    loop,
    found
]

remaining: fn(game: record) = [
    count: number = 0,
    for [i: number = 0, i < game.enemies.length(), i += 1]
        if game.enemies@i.alive then
            count += 1
        end
    loop,
    count
]

attack: fn(game: record, index: number) = [
    foe: record = game.enemies@index,
    damage: number = game.player.power + game.player.inventory@1.damage,
    foe.health = foe.health - damage,
    game.message = "HIT " + foe.name + " FOR {damage}",
    if foe.health <= 0 then
        foe.alive = false
        game.kills += 1
        game.player.experience += 1
        game.player.gold += 5
        game.message = "DEFEATED " + foe.name + " +5 GOLD"
        if game.player.experience >= game.player.experienceToLevel then
            game.player.level += 1
            game.player.experience = 0
            game.player.maxHealth += 5
            game.player.health = game.player.maxHealth
            game.player.power += 1
            game.player.achievements.push(["Level {game.player.level}"])
            game.message = "LEVEL UP! HEALTH AND POWER INCREASED"
        end
    end,
    null
]

enemyTurn: fn(game: record) = [
    for [i: number = 0, i < game.enemies.length(), i += 1]
        foe: record = game.enemies@i
        if foe.alive then
            distance: number = (foe.x - game.player.x).abs() + (foe.y - game.player.y).abs()
            if distance == 1 then
                game.player.health = game.player.health - foe.power
                game.message = foe.name + " STRIKES! HEALTH LOST"
            else if distance <= 4 then
                dx: number = 0
                dy: number = 0
                if foe.x < game.player.x then
                    dx = 1
                else if foe.x > game.player.x then
                    dx = -1
                else if foe.y < game.player.y then
                    dy = 1
                else if foe.y > game.player.y then
                    dy = -1
                end
                targetX: number = foe.x + dx
                targetY: number = foe.y + dy
                if not wall(targetX, targetY) and enemyAt(game, targetX, targetY) == -1 and not (targetX == game.player.x and targetY == game.player.y) then
                    foe.x = targetX
                    foe.y = targetY
                end
            end
        end
    loop,
    if game.player.health <= 0 then
        game.player.health = 0
        game.finished = true
        game.message = "YOU FELL. PRESS R TO RESTART."
    end,
    null
]

step: fn(game: record, action: string) = [
    if game.finished then
        null
    else
        dx: number = 0
        dy: number = 0
        usedTurn: boolean = false
        when
            action == "up" then
                dy = -1
            action == "down" then
                dy = 1
            action == "left" then
                dx = -1
            action == "right" then
                dx = 1
            action == "potion" then
                potions: record = game.player.inventory@0
                if potions.quantity > 0 and game.player.health < game.player.maxHealth then
                    potions.quantity = potions.quantity - 1
                    game.player.health += 6
                    if game.player.health > game.player.maxHealth then
                        game.player.health = game.player.maxHealth
                    end
                    game.message = "DRANK POTION. +6 HEALTH"
                    usedTurn = true
                else
                    game.message = "CANNOT USE POTION"
                end
            otherwise
                null
        end
        if dx != 0 or dy != 0 then
            x: number = game.player.x + dx
            y: number = game.player.y + dy
            if wall(x, y) then
                game.message = "A WALL BLOCKS YOUR PATH"
            else
                index: number = enemyAt(game, x, y)
                if index >= 0 then
                    attack(game, index)
                else
                    game.player.x = x
                    game.player.y = y
                    game.message = "EXPLORE THE CRYPT"
                end
                usedTurn = true
            end
        end
        if usedTurn then
            game.turn += 1
            if game.player.x == exitX and game.player.y == exitY and remaining(game) == 0 then
                game.finished = true
                game.won = true
                game.message = "VICTORY! THE CRYPT IS FREE."
            else
                enemyTurn(game)
            end
        end
        null
    end
]
