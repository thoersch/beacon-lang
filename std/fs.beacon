readText: fn(path: string) = hostReadText(path)

writeText: fn(path: string, value: string) = hostWriteText(path, value)

appendText: fn(path: string, value: string) = [
    existing: string = "",

    if hostPathKind(path) == "file" then
        existing = hostReadText(path)
    end,

    hostWriteText(path, existing + value)
]

exists: fn(path: string) = hostPathKind(path) != "missing"

delete: fn(path: string) = [
    entryKind: string = hostPathKind(path),
    removed: boolean = false,

    if entryKind == "file" then
        removed = hostRemoveFile(path)
    else
        if entryKind == "directory" then
            removed = hostRemoveDirectory(path)
        end
    end,

    removed
]

copy: fn(source: string, destination: string) =
    hostWriteBytes(destination, hostReadBytes(source))

move: fn(source: string, destination: string) =
    hostMovePath(source, destination)

files: fn(path: string) = [
    entries: list = hostReadDirectory(path),
    result: list = [],

    for [i: number = 0, i < entries.length(), i += 1]
        entry: string = entries@i
        if hostPathKind(entry) == "file" then
            result.push(entry)
        end
    loop,

    result
]

directories: fn(path: string) = [
    entries: list = hostReadDirectory(path),
    result: list = [],

    for [i: number = 0, i < entries.length(), i += 1]
        entry: string = entries@i
        if hostPathKind(entry) == "directory" then
            result.push(entry)
        end
    loop,

    result
]

createDirectory: fn(path: string) = hostCreateDirectory(path)
