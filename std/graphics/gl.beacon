// OpenGL-specific operations. The first milestone targets WGL/OpenGL 1.1
// compatibility, including the software renderer on virtual Windows hosts.
buffer: record = {
    color: { id: "color" }
}

version: record = {
    legacy: { major: 1, minor: 1 }
}

available: fn() = hostWindow("available", null)

clearColor: fn(context: record, red: number, green: number, blue: number, alpha: number) = [
    hostNative("opengl", {
        action: "clearColor"
        id: context.id
        red: red
        green: green
        blue: blue
        alpha: alpha
    }),
    null
]

clear: fn(context: record, mask: record) = [
    if not mask.has("id") or mask.id != buffer.color.id then
        fail("Unsupported OpenGL buffer mask; use graphics.gl.buffer.color")
    end,
    hostNative("opengl", {
        action: "clear"
        id: context.id
    }),
    null
]

viewport: fn(context: record, x: number, y: number, width: number, height: number) = [
    hostNative("opengl", {
        action: "viewport"
        id: context.id
        x: x
        y: y
        width: width
        height: height
    }),
    null
]

// Temporary diagnostic primitive, intentionally not a general draw API.
// It demonstrates GL commands reaching the driver from Beacon.
drawLegacyTriangle: fn(context: record) = [
    hostNative("opengl", { action: "triangle", id: context.id }),
    null
]

samplePixel: fn(context: record, x: number, y: number) = [
    result: record = hostNative("opengl", {
        action: "samplePixel"
        id: context.id
        x: x
        y: y
    }),
    result
]


// Draw an entire 2D frame in one native call. Coordinates are in pixels,
// origin at the top-left. Commands are rectangles or built-in bitmap text.
// The batch supports a useful 2D game without any third-party UI framework.
rect: fn(x: number, y: number, width: number, height: number, color: record) = {
    kind: "rect"
    x: x
    y: y
    width: width
    height: height
    red: color.red
    green: color.green
    blue: color.blue
}

text: fn(x: number, y: number, value: string, scale: number, color: record) = {
    kind: "text"
    x: x
    y: y
    text: value
    scale: scale
    red: color.red
    green: color.green
    blue: color.blue
}

drawBatch: fn(context: record, width: number, height: number, commands: list) = [
    hostNative("opengl", {
        action: "batch"
        id: context.id
        width: width
        height: height
        commands: commands
    }),
    null
]
