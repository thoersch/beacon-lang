join: fn(left: string, right: string) = [
    separator: string = hostPathSeparator(),

    when
        left == "" then
            right
        right == "" then
            left
        isAbsolute(right) then
            right
        otherwise
            leftLast: string = left.slice(left.length() - 1, 1)
            rightFirst: string = right.slice(0, 1)
            leftSeparated: boolean = leftLast == separator or (separator == "\\" and leftLast == "/")
            rightSeparated: boolean = rightFirst == separator or (separator == "\\" and rightFirst == "/")

            if leftSeparated and rightSeparated then
                left + right.slice(1)
            else if leftSeparated or rightSeparated then
                left + right
            else
                left + separator + right
            end
    end
]

parent: fn(value: string) = [
    separator: string = hostPathSeparator(),
    endingIndex: number = value.length(),
    trimming: boolean = true,
    hadTrailingSeparator: boolean = false,

    for [i: number = value.length() - 1, i >= 0 and trimming, i = i - 1]
        character: string = value.slice(i, 1)
        separated: boolean = character == separator or (separator == "\\" and character == "/")
        if separated then
            endingIndex = i
            hadTrailingSeparator = true
        else
            trimming = false
        end
    loop,

    separatorIndex: number = -1,
    found: boolean = false,
    if not hadTrailingSeparator then
        for [i: number = endingIndex - 1, i >= 0 and not found, i = i - 1]
            character: string = value.slice(i, 1)
            separated: boolean = character == separator or (separator == "\\" and character == "/")
            if separated then
                separatorIndex = i
                found = true
            end
        loop
    end,

    result: string = "",
    if hadTrailingSeparator then
        if endingIndex > 0 then
            if separator == "\\" and endingIndex == 2 and value.length() >= 2 and value.slice(1, 1) == ":" then
                result = ""
            else
                result = value.slice(0, endingIndex)
            end
        end
    else if separatorIndex == 0 then
        result = value.slice(0, 1)
    else if separator == "\\" and separatorIndex == 2 and value.length() >= 2 and value.slice(1, 1) == ":" then
        result = value.slice(0, 3)
    else if separatorIndex > 0 then
        result = value.slice(0, separatorIndex)
    end,

    result
]

name: fn(value: string) = [
    separator: string = hostPathSeparator(),
    separatorIndex: number = -1,
    found: boolean = false,

    for [i: number = value.length() - 1, i >= 0 and not found, i = i - 1]
        character: string = value.slice(i, 1)
        separated: boolean = character == separator or (separator == "\\" and character == "/")
        if separated then
            separatorIndex = i
            found = true
        end
    loop,

    value.slice(separatorIndex + 1)
]

extension: fn(value: string) = [
    file: string = name(value),
    dotIndex: number = -1,
    found: boolean = false,

    for [i: number = file.length() - 1, i >= 0 and not found, i = i - 1]
        if file.slice(i, 1) == "." then
            dotIndex = i
            found = true
        end
    loop,

    result: string = "",
    if dotIndex >= 0 and dotIndex < file.length() - 1 then
        result = file.slice(dotIndex)
    end,

    result
]

withoutExtension: fn(value: string) = [
    ext: string = extension(value),
    result: string = value,

    if ext.length() > 0 then
        result = value.slice(0, value.length() - ext.length())
    end,

    result
]

isAbsolute: fn(value: string) = [
    separator: string = hostPathSeparator(),

    when
        value == "" then
            false
        separator == "/" then
            value.slice(0, 1) == "/"
        value.length() >= 2 and
        (value.slice(0, 1) == "\\" or value.slice(0, 1) == "/") and
        (value.slice(1, 1) == "\\" or value.slice(1, 1) == "/") then
            true
        value.length() >= 3 and
        value.slice(1, 1) == ":" and
        (value.slice(2, 1) == "\\" or value.slice(2, 1) == "/") then
            true
        otherwise
            false
    end
]

normalize: fn(value: string) = hostAbsolutePath(value)
