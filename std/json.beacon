_jsonError: fn(state: record, message: string) =
    fail("Invalid JSON at character {state.pos}: {message}")

_jsonPeek: fn(state: record) =
    if state.pos < state.source.length() then
        state.source.slice(state.pos, 1)
    else
        ""
    end

_jsonIsWhitespace: fn(character: string) =
    character == " " or character == "\t" or character == "\n" or character == "\r"

_jsonSkipWhitespace: fn(state: record) = [
    scanning: boolean = true,

    for [keep: boolean = true, keep, keep = keep]
        character: string = _jsonPeek(state)
        if character != "" and _jsonIsWhitespace(character) then
            state.pos += 1
        else
            keep = false
        end
    loop,

    null
]

_jsonIsDigit: fn(character: string) =
    character == "0" or character == "1" or character == "2" or character == "3" or
    character == "4" or character == "5" or character == "6" or character == "7" or
    character == "8" or character == "9"

_jsonIsNonZeroDigit: fn(character: string) =
    character == "1" or character == "2" or character == "3" or character == "4" or
    character == "5" or character == "6" or character == "7" or character == "8" or
    character == "9"

_jsonHexValue: fn(character: string) =
    when
        character == "0" then
            0
        character == "1" then
            1
        character == "2" then
            2
        character == "3" then
            3
        character == "4" then
            4
        character == "5" then
            5
        character == "6" then
            6
        character == "7" then
            7
        character == "8" then
            8
        character == "9" then
            9
        character == "a" or character == "A" then
            10
        character == "b" or character == "B" then
            11
        character == "c" or character == "C" then
            12
        character == "d" or character == "D" then
            13
        character == "e" or character == "E" then
            14
        character == "f" or character == "F" then
            15
        otherwise
            -1
    end

_jsonParseHex4: fn(state: record) = [
    value: number = 0,

    for [i: number = 0, i < 4, i += 1]
        if state.pos >= state.source.length() then
            _jsonError(state, "Incomplete Unicode escape")
        end

        digit: number = _jsonHexValue(state.source.slice(state.pos, 1))
        if digit < 0 then
            _jsonError(state, "Unicode escape must contain four hexadecimal digits")
        end

        value = value * 16 + digit
        state.pos += 1
    loop,

    value
]

_jsonParseUnicodeEscape: fn(state: record) = [
    first: number = _jsonParseHex4(state),
    codePoint: number = first,

    if first >= 55296 and first <= 56319 then
        if state.pos + 2 > state.source.length() or state.source.slice(state.pos, 2) != "\\u" then
            _jsonError(state, "High surrogate must be followed by a low surrogate Unicode escape")
        end

        state.pos += 2
        second: number = _jsonParseHex4(state)
        if second < 56320 or second > 57343 then
            _jsonError(state, "High surrogate must be followed by a low surrogate Unicode escape")
        end

        codePoint = 65536 + (first - 55296) * 1024 + (second - 56320)
    else if first >= 56320 and first <= 57343 then
        _jsonError(state, "Low surrogate must follow a high surrogate Unicode escape")
    end,

    hostCharacter(codePoint)
]

_jsonControlCode: fn(character: string) = [
    result: number = -1,

    for [i: number = 0, i < 32 and result == -1, i += 1]
        if character == hostCharacter(i) then
            result = i
        end
    loop,

    result
]

_jsonParseString: fn(state: record) = [
    result: string = "",
    done: boolean = false,

    state.pos += 1,

    for [reading: boolean = true, reading, reading = reading]
        if state.pos >= state.source.length() then
            _jsonError(state, "Unterminated string")
        end

        character: string = state.source.slice(state.pos, 1)
        state.pos += 1

        if character == "\"" then
            reading = false
            done = true
        else if character == "\\" then
            if state.pos >= state.source.length() then
                _jsonError(state, "Unterminated escape sequence")
            end

            escape: string = state.source.slice(state.pos, 1)
            state.pos += 1

            when
                escape == "\"" then
                    result += "\""
                escape == "\\" then
                    result += "\\"
                escape == "/" then
                    result += "/"
                escape == "b" then
                    result += hostCharacter(8)
                escape == "f" then
                    result += hostCharacter(12)
                escape == "n" then
                    result += "\n"
                escape == "r" then
                    result += "\r"
                escape == "t" then
                    result += "\t"
                escape == "u" then
                    result += _jsonParseUnicodeEscape(state)
                otherwise
                    _jsonError(state, "Invalid string escape")
            end
        else
            if _jsonControlCode(character) >= 0 then
                _jsonError(state, "Unescaped control character in string")
            end
            result += character
        end
    loop,

    if not done then
        _jsonError(state, "Unterminated string")
    end,

    result
]

_jsonParseNumber: fn(state: record) = [
    start: number = state.pos,
    character: string = _jsonPeek(state),

    if character == "-" then
        state.pos += 1
        character = _jsonPeek(state)
    end,

    if character == "0" then
        state.pos += 1
        if _jsonIsDigit(_jsonPeek(state)) then
            _jsonError(state, "Numbers cannot contain leading zeroes")
        end
    else if _jsonIsNonZeroDigit(character) then
        for [digits: boolean = true, digits, digits = digits]
            if _jsonIsDigit(_jsonPeek(state)) then
                state.pos += 1
            else
                digits = false
            end
        loop
    else
        _jsonError(state, "Expected a digit")
    end,

    if _jsonPeek(state) == "." then
        state.pos += 1
        if not _jsonIsDigit(_jsonPeek(state)) then
            _jsonError(state, "Fraction requires at least one digit")
        end
        for [fraction: boolean = true, fraction, fraction = fraction]
            if _jsonIsDigit(_jsonPeek(state)) then
                state.pos += 1
            else
                fraction = false
            end
        loop
    end,

    character = _jsonPeek(state),
    if character == "e" or character == "E" then
        state.pos += 1
        character = _jsonPeek(state)
        if character == "+" or character == "-" then
            state.pos += 1
        end
        if not _jsonIsDigit(_jsonPeek(state)) then
            _jsonError(state, "Exponent requires at least one digit")
        end
        for [exponent: boolean = true, exponent, exponent = exponent]
            if _jsonIsDigit(_jsonPeek(state)) then
                state.pos += 1
            else
                exponent = false
            end
        loop
    end,

    raw: string = state.source.slice(start, state.pos - start),
    value: number = number(raw),
    rendered: string = "{value}",

    if rendered == "NaN" or rendered == "Infinity" or rendered == "-Infinity" then
        _jsonError(state, "Number is outside Beacon's finite Number range")
    end,

    value
]

_jsonExpectLiteral: fn(state: record, literal: string) = [
    for [i: number = 0, i < literal.length(), i += 1]
        if state.pos >= state.source.length() or
            state.source.slice(state.pos, 1) != literal.slice(i, 1) then
            _jsonError(state, "Invalid literal")
        end
        state.pos += 1
    loop,

    null
]

_jsonParseArray: fn(state: record) = [
    result: list = [],
    done: boolean = false,

    state.pos += 1,
    _jsonSkipWhitespace(state),

    if _jsonPeek(state) == "]" then
        state.pos += 1
        done = true
    end,

    for [reading: boolean = not done, reading, reading = reading]
        result.push(_jsonParseValue(state))
        _jsonSkipWhitespace(state)

        character: string = _jsonPeek(state)
        if character == "," then
            state.pos += 1
            _jsonSkipWhitespace(state)
        else if character == "]" then
            state.pos += 1
            reading = false
        else
            _jsonError(state, "Expected ',' or ']' in array")
        end
    loop,

    result
]

_jsonParseObject: fn(state: record) = [
    result: record = {},
    done: boolean = false,

    state.pos += 1,
    _jsonSkipWhitespace(state),

    if _jsonPeek(state) == "}" then
        state.pos += 1
        done = true
    end,

    for [reading: boolean = not done, reading, reading = reading]
        if _jsonPeek(state) != "\"" then
            _jsonError(state, "Object keys must be strings")
        end

        key: string = _jsonParseString(state)
        _jsonSkipWhitespace(state)

        if _jsonPeek(state) != ":" then
            _jsonError(state, "Expected ':' after object key")
        end
        state.pos += 1
        _jsonSkipWhitespace(state)

        result.set(key, _jsonParseValue(state))
        _jsonSkipWhitespace(state)

        character: string = _jsonPeek(state)
        if character == "," then
            state.pos += 1
            _jsonSkipWhitespace(state)
        else if character == "}" then
            state.pos += 1
            reading = false
        else
            _jsonError(state, "Expected ',' or '}' in object")
        end
    loop,

    result
]

_jsonParseValue: fn(state: record) = [
    _jsonSkipWhitespace(state),
    character: string = _jsonPeek(state),
    result: atom | list | record = null,

    when
        character == "\"" then
            result = _jsonParseString(state)
        character == "[" then
            result = _jsonParseArray(state)
        character == "{" then
            result = _jsonParseObject(state)
        character == "t" then
            _jsonExpectLiteral(state, "true")
            result = true
        character == "f" then
            _jsonExpectLiteral(state, "false")
            result = false
        character == "n" then
            _jsonExpectLiteral(state, "null")
            result = null
        character == "-" or _jsonIsDigit(character) then
            result = _jsonParseNumber(state)
        otherwise
            _jsonError(state, "Expected a JSON value")
    end,

    result
]

parse: fn(source: string) = [
    state: record = {
        source: source
        pos: 0
    },

    value: atom | list | record = _jsonParseValue(state),
    _jsonSkipWhitespace(state),

    if state.pos != source.length() then
        _jsonError(state, "Unexpected trailing content")
    end,

    value
]

_jsonHexDigit: fn(value: number) =
    "0123456789abcdef".slice(value, 1)

_jsonControlEscape: fn(code: number) =
    when
        code == 8 then
            "\\b"
        code == 9 then
            "\\t"
        code == 10 then
            "\\n"
        code == 12 then
            "\\f"
        code == 13 then
            "\\r"
        otherwise
            if code < 16 then
                "\\u000" + _jsonHexDigit(code)
            else
                "\\u001" + _jsonHexDigit(code - 16)
            end
    end

_jsonEncodeString: fn(value: string) = [
    result: string = "\"",

    for [i: number = 0, i < value.length(), i += 1]
        character: string = value.slice(i, 1)
        if character == "\"" then
            result += "\\\""
        else if character == "\\" then
            result += "\\\\"
        else
            control: number = _jsonControlCode(character)
            if control >= 0 then
                result += _jsonControlEscape(control)
            else
                result += character
            end
        end
    loop,

    result + "\""
]

_jsonContainsIdentity: fn(values: list, target: list | record) = [
    found: boolean = false,

    for [i: number = 0, i < values.length() and not found, i += 1]
        if values@i == target then
            found = true
        end
    loop,

    found
]

_jsonEncodeNumber: fn(value: number) = [
    result: string = "{value}",

    if result == "NaN" or result == "Infinity" or result == "-Infinity" then
        fail("json.stringify() cannot encode a non-finite Number")
    end,

    result
]

_jsonEncodeList: fn(value: list, active: list) = [
    if _jsonContainsIdentity(active, value) then
        fail("json.stringify() cannot encode a cyclic List or Record")
    end,

    active.push(value),
    result: string = "[",

    for [i: number = 0, i < value.length(), i += 1]
        if i > 0 then
            result += ","
        end
        result += _jsonEncode(value@i, active)
    loop,

    active.pop(),
    result + "]"
]

_jsonEncodeRecord: fn(value: record, active: list) = [
    if _jsonContainsIdentity(active, value) then
        fail("json.stringify() cannot encode a cyclic List or Record")
    end,

    active.push(value),
    keys: list = value.keys(),
    result: string = "{",

    for [i: number = 0, i < keys.length(), i += 1]
        key: string = keys@i
        if i > 0 then
            result += ","
        end
        result += _jsonEncodeString(key) + ":" + _jsonEncode(value.get(key), active)
    loop,

    active.pop(),
    result + "}"
]

_jsonEncode: fn(value: atom | list | record | fn | type, active: list) = [
    valueKind: string = kind(value),
    result: string = "",

    when
        valueKind == "null" then
            result = "null"
        valueKind == "boolean" then
            if value then
                result = "true"
            else
                result = "false"
            end
        valueKind == "number" then
            result = _jsonEncodeNumber(value)
        valueKind == "string" then
            result = _jsonEncodeString(value)
        valueKind == "list" then
            result = _jsonEncodeList(value, active)
        valueKind == "record" then
            result = _jsonEncodeRecord(value, active)
        otherwise
            fail("json.stringify() cannot encode Beacon value of kind {valueKind}")
    end,

    result
]

stringify: fn(value: atom | list | record | fn | type) =
    _jsonEncode(value, [])
