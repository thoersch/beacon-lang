text: fn(value: string) = {
    kind: "text"
    text: value
}

heading: fn(value: string) = {
    kind: "heading"
    text: value
}

button: fn(label: string, onClick: fn) = {
    kind: "button"
    text: label
    callback: onClick
}

input: fn(value: string, onChange: fn) = {
    kind: "input"
    text: value
    callback: onChange
}

textArea: fn(value: string, height: number) = {
    kind: "textArea"
    text: value
    height: height
}

spacer: fn(height: number) = {
    kind: "spacer"
    height: height
}

row: fn(children: list) = {
    kind: "row"
    children: children
}

column: fn(children: list) = {
    kind: "column"
    children: children
}

panel: fn(children: list) = {
    kind: "panel"
    children: children
}

measureHeight: fn<private>(node: record, width: number) = [
    result: number = 0,

    if node.kind == "text" then
        result = 24
    else if node.kind == "heading" then
        result = 34
    else if node.kind == "button" then
        result = 34
    else if node.kind == "input" then
        result = 32
    else if node.kind == "textArea" then
        result = node.height
    else if node.kind == "spacer" then
        result = node.height
    else if node.kind == "row" then
        count: number = node.children.length()
        childWidth: number = width
        if count > 0 then
            childWidth = (width - (count - 1) * 8) / count
        end

        for [i: number = 0, i < count, i += 1]
            childHeight: number = measureHeight(node.children@i, childWidth)
            if childHeight > result then
                result = childHeight
            end
        loop
    else if node.kind == "column" then
        for [i: number = 0, i < node.children.length(), i += 1]
            if i > 0 then
                result += 8
            end
            result += measureHeight(node.children@i, width)
        loop
    else if node.kind == "panel" then
        contentHeight: number = 0
        for [i: number = 0, i < node.children.length(), i += 1]
            if i > 0 then
                contentHeight += 8
            end
            contentHeight += measureHeight(node.children@i, width - 24)
        loop
        result = contentHeight + 24
    else
        fail("Unknown std.ui node kind: {node.kind}")
    end,

    result
]

registerCallback: fn<private>(state: record, callback: fn, mode: string) = [
    next: number = state.next + 1,
    state.next = next,
    key: string = "{next}",
    handlers: record = state.handlers,
    handlers.set(key, {
        mode: mode
        callback: callback
    }),
    key
]

layoutNode: fn<private>(node: record, x: number, y: number, width: number, controls: list, state: record) = [
    height: number = measureHeight(node, width),

    if node.kind == "text" or node.kind == "heading" then
        controls.push({
            kind: node.kind
            x: x
            y: y
            width: width
            height: height
            text: node.text
            action: ""
        })
    else if node.kind == "button" then
        action: string = registerCallback(state, node.callback, "click")
        controls.push({
            kind: "button"
            x: x
            y: y
            width: width
            height: height
            text: node.text
            action: action
        })
    else if node.kind == "input" then
        action: string = registerCallback(state, node.callback, "input")
        controls.push({
            kind: "input"
            x: x
            y: y
            width: width
            height: height
            text: node.text
            action: action
        })
    else if node.kind == "textArea" then
        controls.push({
            kind: "textArea"
            x: x
            y: y
            width: width
            height: height
            text: node.text
            action: ""
        })
    else if node.kind == "spacer" then
        null
    else if node.kind == "column" then
        nextY: number = y
        for [i: number = 0, i < node.children.length(), i += 1]
            if i > 0 then
                nextY += 8
            end
            child: record = node.children@i
            childHeight: number = layoutNode(child, x, nextY, width, controls, state)
            nextY += childHeight
        loop
    else if node.kind == "row" then
        count: number = node.children.length()
        childWidth: number = width
        if count > 0 then
            childWidth = (width - (count - 1) * 8) / count
        end

        for [i: number = 0, i < count, i += 1]
            childX: number = x + i * (childWidth + 8)
            layoutNode(node.children@i, childX, y, childWidth, controls, state)
        loop
    else if node.kind == "panel" then
        controls.push({
            kind: "panel"
            x: x
            y: y
            width: width
            height: height
            text: ""
            action: ""
        })

        nextY: number = y + 12
        for [i: number = 0, i < node.children.length(), i += 1]
            if i > 0 then
                nextY += 8
            end
            child: record = node.children@i
            childHeight: number = layoutNode(child, x + 12, nextY, width - 24, controls, state)
            nextY += childHeight
        loop
    else
        fail("Unknown std.ui node kind: {node.kind}")
    end,

    height
]

mount: fn(app: record, root: record) = [
    controls: list = [],
    state: record = {
        next: 0
        handlers: {}
    },
    width: number = app.width - 32,

    if width < 1 then
        width = 1
    end,

    layoutNode(root, 16, 16, width, controls, state),
    hostWindow("controls", {
        id: app.id
        controls: controls
    }),

    app.set("uiHandlers", state.handlers),
    app.set("uiRoot", root),
    app
]

dispatchEvent: fn<private>(app: record, event: record) = [
    if event.type == "resize" then
        app.width = event.width
        app.height = event.height
        if app.has("uiRoot") then
            mount(app, app.get("uiRoot"))
        end
    else if event.type == "action" or event.type == "input" then
        if app.has("uiHandlers") then
            handlers: record = app.get("uiHandlers")
            if handlers.has(event.action) then
                handler: record = handlers.get(event.action)
                if handler.mode == "input" then
                    handler.callback(event.value)
                else
                    handler.callback()
                end
            end
        end
    end,
    null
]

run: fn(app: record) = [
    running: boolean = true,

    for [tick: number = 0, running, tick += 1]
        event: record = hostWindow("next", app.id)
        if event.type == "close" then
            running = false
        else
            dispatchEvent(app, event)
        end
    loop,

    null
]
