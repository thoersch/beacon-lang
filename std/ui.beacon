text: fn(value: string) = {
    kind: "text"
    text: value
}

muted: fn(value: string) = {
    kind: "muted"
    text: value
}

heading: fn(value: string) = {
    kind: "heading"
    text: value
}

button: fn(label: string, onClick: fn) = {
    kind: "button"
    variant: "secondary"
    text: label
    callback: onClick
}

primaryButton: fn(label: string, onClick: fn) = {
    kind: "button"
    variant: "primary"
    text: label
    callback: onClick
}

input: fn(placeholder: string, onChange: fn) = {
    kind: "input"
    placeholder: placeholder
    callback: onChange
}

textArea: fn(value: string, height: number) = {
    kind: "textArea"
    text: value
    height: height
}

code: fn(value: string, height: number) = {
    kind: "code"
    text: value
    height: height
}

spacer: fn(height: number) = {
    kind: "spacer"
    height: height
}

row: fn(children: list) = {
    kind: "row"
    children: children
}

column: fn(children: list) = {
    kind: "column"
    children: children
}

panel: fn(children: list) = {
    kind: "panel"
    children: children
}

preferredWidth: fn<private>(node: record) = [
    result: number = -1,

    if node.kind == "button" then
        result = node.text.length() * 8 + 40
        if result < 96 then
            result = 96
        end
        if result > 240 then
            result = 240
        end
    end,

    result
]

measureHeight: fn<private>(node: record, width: number) = [
    result: number = 0,

    when
        node.kind == "text" then
            result = 24
        node.kind == "muted" then
            result = 22
        node.kind == "heading" then
            result = 34
        node.kind == "button" then
            result = 38
        node.kind == "input" then
            result = 40
        node.kind == "textArea" or node.kind == "code" then
            result = node.height
        node.kind == "spacer" then
            result = node.height
        node.kind == "row" then
            for [i: number = 0, i < node.children.length(), i += 1]
                childHeight: number = measureHeight(node.children@i, width)
                if childHeight > result then
                    result = childHeight
                end
            loop
        node.kind == "column" then
            for [i: number = 0, i < node.children.length(), i += 1]
                if i > 0 then
                    result += 12
                end
                result += measureHeight(node.children@i, width)
            loop
        node.kind == "panel" then
            contentHeight: number = 0
            for [i: number = 0, i < node.children.length(), i += 1]
                if i > 0 then
                    contentHeight += 12
                end
                contentHeight += measureHeight(node.children@i, width - 40)
            loop
            result = contentHeight + 40
        otherwise
            fail("Unknown std.ui node kind: {node.kind}")
    end,

    result
]

registerCallback: fn<private>(state: record, callback: fn, mode: string) = [
    next: number = state.next + 1,
    state.next = next,
    key: string = "{next}",
    handlers: record = state.handlers,
    handlers.set(key, {
        mode: mode
        callback: callback
    }),
    key
]

pushTextControl: fn<private>(node: record, x: number, y: number, width: number, height: number, surface: boolean, controls: list) = [
    controls.push({
        kind: node.kind
        x: x
        y: y
        width: width
        height: height
        text: node.text
        action: ""
        surface: surface
    }),
    null
]

layoutNode: fn<private>(node: record, x: number, y: number, width: number, surface: boolean, controls: list, state: record) = [
    height: number = measureHeight(node, width),

    when
        node.kind == "text" or node.kind == "muted" or node.kind == "heading" then
            pushTextControl(node, x, y, width, height, surface, controls)
        node.kind == "button" then
            action: string = registerCallback(state, node.callback, "click")
            controls.push({
                kind: "button"
                variant: node.variant
                x: x
                y: y
                width: width
                height: height
                text: node.text
                action: action
                surface: surface
            })
        node.kind == "input" then
            action: string = registerCallback(state, node.callback, "input")
            controls.push({
                kind: "input"
                x: x
                y: y
                width: width
                height: height
                text: ""
                placeholder: node.placeholder
                action: action
                surface: surface
            })
        node.kind == "textArea" or node.kind == "code" then
            controls.push({
                kind: node.kind
                x: x
                y: y
                width: width
                height: height
                text: node.text
                action: ""
                surface: surface
            })
        node.kind == "spacer" then
            null
        node.kind == "column" then
            nextY: number = y
            for [i: number = 0, i < node.children.length(), i += 1]
                if i > 0 then
                    nextY += 12
                end
                child: record = node.children@i
                childHeight: number = layoutNode(child, x, nextY, width, surface, controls, state)
                nextY += childHeight
            loop
        node.kind == "row" then
            count: number = node.children.length()
            fixedWidth: number = 0
            growCount: number = 0
            gapWidth: number = 0

            if count > 1 then
                gapWidth = (count - 1) * 10
            end

            for [i: number = 0, i < count, i += 1]
                childPreferred: number = preferredWidth(node.children@i)
                if childPreferred < 0 then
                    growCount += 1
                else
                    fixedWidth += childPreferred
                end
            loop

            growWidth: number = 0
            if growCount > 0 then
                growWidth = (width - fixedWidth - gapWidth) / growCount
                if growWidth < 1 then
                    growWidth = 1
                end
            end

            nextX: number = x
            for [i: number = 0, i < count, i += 1]
                child: record = node.children@i
                childWidth: number = preferredWidth(child)
                if childWidth < 0 then
                    childWidth = growWidth
                end
                layoutNode(child, nextX, y, childWidth, surface, controls, state)
                nextX += childWidth + 10
            loop
        node.kind == "panel" then
            controls.push({
                kind: "panel"
                x: x
                y: y
                width: width
                height: height
                text: ""
                action: ""
                surface: true
            })

            nextY: number = y + 20
            for [i: number = 0, i < node.children.length(), i += 1]
                if i > 0 then
                    nextY += 12
                end
                child: record = node.children@i
                childHeight: number = layoutNode(child, x + 20, nextY, width - 40, true, controls, state)
                nextY += childHeight
            loop
        otherwise
            fail("Unknown std.ui node kind: {node.kind}")
    end,

    height
]

mount: fn(app: record, root: record) = [
    controls: list = [],
    state: record = {
        next: 0
        handlers: {}
    },
    width: number = app.width - 56,

    if width < 1 then
        width = 1
    end,

    layoutNode(root, 28, 28, width, false, controls, state),
    hostWindow("controls", {
        id: app.id
        controls: controls
    }),

    app.set("uiHandlers", state.handlers),
    app.set("uiRoot", root),
    app
]

dispatchEvent: fn<private>(app: record, event: record) = [
    if event.type == "resize" then
        app.width = event.width
        app.height = event.height
        if app.has("uiRoot") then
            mount(app, app.get("uiRoot"))
        end
    else if event.type == "action" or event.type == "input" then
        if app.has("uiHandlers") then
            handlers: record = app.get("uiHandlers")
            if handlers.has(event.action) then
                handler: record = handlers.get(event.action)
                if handler.mode == "input" then
                    handler.callback(event.value)
                else
                    handler.callback()
                end
            end
        end
    end,
    null
]

run: fn(app: record) = [
    running: boolean = true,

    for [tick: number = 0, running, tick += 1]
        event: record = hostWindow("next", app.id)
        if event.type == "close" then
            running = false
        else
            dispatchEvent(app, event)
        end
    loop,

    null
]
