include "chess/rules"
s: record = chess.newGame()
print(s.board@52)
print(s.turn)
print(side("P"))
print(side("p"))
print(pieceType("P"))
print(row(52))
print(pseudo(s).length())
print(inCheck(s,1))
print(attacked(s.board,60,-1))

print(chess.square("e", 2))
print(chess.square("e", 4))
moves: list = chess.legal(s)
print(moves.length())
for [i: number = 0, i < moves.length(), i += 1]
    m: record = moves@i
    if m.from == 52 then
        print(m.from)
        print(m.to)
        print(m.promotion)
        print(m.flag)
    end
loop
found: record = chess.findMove(s, 52, 36, "")
print(found.valid)
