// BEACON CHESS: human vs Beacon AI or local two-player play.
// Chess mechanics and the entire UI are written in Beacon.
// The existing std.graphics.gl extension is only a generic rectangle/text renderer.
include std.window
include std.graphics
include std.graphics.gl
include "chess/rules"
include "chess/ai"
include "chess/art"
include "chess/ui"

bg: record = { red: 0.055, green: 0.070, blue: 0.095 }
surface: record = { red: 0.10, green: 0.14, blue: 0.19 }
lightSquare: record = { red: 0.86, green: 0.84, blue: 0.76 }
darkSquare: record = { red: 0.31, green: 0.42, blue: 0.47 }
selectedColor: record = { red: 0.90, green: 0.72, blue: 0.31 }
hintColor: record = { red: 0.38, green: 0.80, blue: 0.62 }
ivory: record = { red: 0.96, green: 0.94, blue: 0.84 }
night: record = { red: 0.13, green: 0.18, blue: 0.25 }
gold: record = { red: 0.92, green: 0.73, blue: 0.37 }
textColor: record = { red: 0.92, green: 0.94, blue: 0.94 }
muted: record = { red: 0.54, green: 0.64, blue: 0.69 }
danger: record = { red: 0.82, green: 0.33, blue: 0.32 }

tile: number = 64
originX: number = 48
originY: number = 88
sidebar: number = 594

newSession: fn() = {
    history: [chess.newGame()]
    moves: []
    selected: -1
    pending: false
    from: -1
    to: -1
    message: "SELECT A PIECE TO BEGIN"
    claimed: false
    vsComputer: true
    aiLevel: 2
    thinkActive: false
    thinkMoves: []
    thinkIndex: 0
    thinkComplete: false
    releaseReady: false
    computeToken: 0
    releaseToken: 0
    thinkScore: -200000
    thinkAlpha: -200000
    thinkBest: { valid: false, from: -1, to: -1, promotion: "", flag: "" }
    wakeToken: 0
    moveDetails: []
}

current: fn(session: record) = session.history@(session.history.length() - 1)

appendRect: fn(commands: list, x: number, y: number, w: number, h: number, color: record) = [
    commands.push(graphics.gl.rect(x, y, w, h, color)),
    null
]
appendText: fn(commands: list, x: number, y: number, value: string, scale: number, color: record) = [
    commands.push(graphics.gl.text(x, y, value, scale, color)),
    null
]

// Dedicated recognizable Beacon pixel-art sprites, no external art package.
drawPiece: fn(commands: list, piece: string, x: number, y: number) =
    chessArt.draw(commands, piece, x, y)

hasTarget: fn(options: list, selected: number, target: number) = [
    yes: boolean = false,
    for [i: number = 0, i < options.length(), i += 1]
        m: record = options@i
        if m.from == selected and m.to == target then
            yes = true
            break
        end
    loop,
    yes
]

draw: fn(context: record, app: record, session: record) = [
    state: record = current(session),
    result: record = chess.status(session.history),
    options: list = [],
    lastFrom: number = -1,
    lastTo: number = -1,
    labels: record = chessUI.labels(state, session.aiLevel),
    if session.moveDetails.length() > 0 then
        last: record = session.moveDetails@(session.moveDetails.length() - 1)
        lastFrom = last.from
        lastTo = last.to
    end,
    if session.selected >= 0 then
        options = chess.legal(state)
    end,
    cmds: list = [],
    appendRect(cmds, 0, 0, app.width, app.height, bg),
    appendText(cmds, 48, 26, "BEACON CHESS", 4, gold),
    appendText(cmds, 49, 60, "100 PERCENT BEACON GAME LOGIC", 1, muted),

    for [r: number = 0, r < 8, r += 1]
        for [c: number = 0, c < 8, c += 1]
            i: number = r * 8 + c
            x: number = originX + c * tile
            y: number = originY + r * tile
            parity: number = r + c - math.floor((r + c) / 2) * 2
            squareColor: record = lightSquare
            if parity == 1 then
                squareColor = darkSquare
            end
            if lastFrom == i or lastTo == i then
                squareColor = { red: 0.64, green: 0.76, blue: 0.44 }
            end
            if session.selected == i then
                squareColor = selectedColor
            end
            appendRect(cmds, x, y, tile, tile, squareColor)
            if state.board@i != "." then
                drawPiece(cmds, state.board@i, x, y)
            end
            if session.selected >= 0 and hasTarget(options, session.selected, i) then
                if state.board@i == "." then
                    appendRect(cmds, x + 29, y + 29, 8, 8, hintColor)
                else
                    appendRect(cmds, x + 2, y + 2, 60, 3, hintColor)
                    appendRect(cmds, x + 2, y + 59, 60, 3, hintColor)
                end
            end
        loop
    loop,

    appendRect(cmds, sidebar, originY, 236, 512, surface),
    appendText(cmds, sidebar + 15, 109, "MATCH STATUS", 2, gold),
    if session.thinkActive then
        appendText(cmds, sidebar + 15, 145, "COMPUTER THINKING", 1, textColor)
    else
        appendText(cmds, sidebar + 15, 145, result.message, 1, textColor)
    end,
    appendText(cmds, sidebar + 15, 180, labels.move, 2, textColor),
    appendText(cmds, sidebar + 15, 212, labels.half, 2, muted),
    appendText(cmds, sidebar + 15, 251, "CONTROLS", 2, gold),
    appendText(cmds, sidebar + 15, 279, "CLICK PIECE", 2, textColor),
    appendText(cmds, sidebar + 15, 307, "CLICK TARGET", 2, textColor),
    appendRect(cmds, sidebar + 15, 354, 99, 37, darkSquare),
    appendText(cmds, sidebar + 29, 366, "UNDO", 2, textColor),
    appendRect(cmds, sidebar + 123, 354, 98, 37, darkSquare),
    appendText(cmds, sidebar + 130, 366, "RESET", 2, textColor),

    appendRect(cmds, sidebar + 15, 405, 205, 31, darkSquare),
    if session.vsComputer then
        appendText(cmds, sidebar + 25, 416, "VS COMPUTER", 2, textColor)
    else
        appendText(cmds, sidebar + 25, 416, "TWO PLAYERS", 2, textColor)
    end,
    appendRect(cmds, sidebar + 15, 445, 205, 31, darkSquare),
    appendText(cmds, sidebar + 25, 456, labels.level, 2, textColor),
    appendText(cmds, sidebar + 15, 482, "M MODE  L LEVEL", 1, muted),

    if session.pending then
        appendRect(cmds, sidebar + 12, 497, 212, 85, bg)
        appendText(cmds, sidebar + 23, 503, "PROMOTE PAWN", 2, gold)
        appendText(cmds, sidebar + 23, 530, "Q   R   B   N", 2, textColor)
        appendText(cmds, sidebar + 23, 557, "PRESS Q R B OR N", 1, muted)
    else
        appendText(cmds, sidebar + 15, 511, "LAST MOVE", 2, gold)
        if session.moves.length() > 0 then
            appendText(cmds, sidebar + 15, 549, session.moves@(session.moves.length() - 1), 2, textColor)
        else
            appendText(cmds, sidebar + 15, 549, "NEW GAME", 2, muted)
        end
    end,

    appendText(cmds, 49, 621, session.message, 2, gold),
    graphics.gl.clearColor(context, bg.red, bg.green, bg.blue, 1.0),
    graphics.gl.clear(context, graphics.gl.buffer.color),
    graphics.gl.drawBatch(context, app.width, app.height, cmds),
    graphics.present(context),
    null
]

commitMove: fn(session: record, move: record) = [
    old: record = current(session),
    played: record = chess.apply(old, move),
    label: string = chess.name(move.from) + chess.name(move.to) + move.promotion,
    session.history.push(played),
    session.moves.push(label),
    session.moveDetails.push(move),
    session.selected = -1,
    session.pending = false,
    session.message = "PLAYED " + label,
    actor: string = "WHITE",
    if old.turn == -1 then
        actor = "BLACK"
    end,
    print("{actor} {label}"),
    null
]
// Native wakeups only enqueue window events; chess decisions and game state
// remain entirely in Beacon. The human move is rendered before AI begins.
scheduleWake: fn(session: record, context: record, delay: number) = [
    session.wakeToken += 1,
    if session.wakeToken > 30000 then
        session.wakeToken = 1
    end,
    token: number = session.wakeToken,
    graphics.gl.requestWake(context, delay, token),
    token
]

startComputer: fn(session: record, context: record) = [
    state: record = current(session),
    result: record = chess.status(session.history),
    if session.vsComputer and state.turn == -1 and not result.finished and not session.claimed and not session.pending then
        session.thinkActive = true
        session.thinkMoves = chessAI.ordered(state, chess.legal(state))
        session.thinkIndex = 0
        session.thinkComplete = false
        session.releaseReady = false
        session.thinkScore = -200000
        session.thinkAlpha = -200000
        session.thinkBest = { valid: false, from: -1, to: -1, promotion: "", flag: "" }
        session.message = "YOUR MOVE IS PLAYED - COMPUTER NEXT"
        // Search in small chunks while the human move remains highlighted.
        // The computer cannot play until the independent 1.4s gate fires.
        session.releaseToken = scheduleWake(session, context, 1400)
        session.computeToken = scheduleWake(session, context, 20)
    end,
    null
]

// One root candidate per wake: repainting and user input resume between
// candidates. Compute and display-delay timers are independent, so useful
// thinking occurs DURING the pause rather than extending it.
advanceComputer: fn(session: record, context: record, token: number) = [
    if session.thinkActive then
        if token == session.releaseToken then
            session.releaseReady = true
        else if token == session.computeToken and not session.thinkComplete then
            state: record = current(session)
            if session.thinkIndex < session.thinkMoves.length() then
                move: record = session.thinkMoves@(session.thinkIndex)
                score: number = chessAI.scoreCandidate(state, move, session.aiLevel, session.thinkAlpha)
                if score > session.thinkScore then
                    session.thinkScore = score
                    session.thinkBest = {
                        valid: true
                        from: move.from
                        to: move.to
                        promotion: move.promotion
                        flag: move.flag
                    }
                end
                if score > session.thinkAlpha then
                    session.thinkAlpha = score
                end
                session.thinkIndex += 1
            end
            if session.thinkIndex >= session.thinkMoves.length() then
                session.thinkComplete = true
            else
                session.computeToken = scheduleWake(session, context, 12)
            end
        end
        if session.releaseReady and session.thinkComplete then
            session.thinkActive = false
            if session.thinkBest.valid then
                commitMove(session, session.thinkBest)
                played: record = session.thinkBest
                session.message = "COMPUTER " + chess.name(played.from) + chess.name(played.to) + played.promotion
            end
        end
    end,
    null
]

toggleMode: fn(session: record, context: record) = [
    session.vsComputer = not session.vsComputer,
    session.selected = -1,
    session.thinkActive = false,
    session.wakeToken += 1,
    if session.vsComputer then
        session.message = "PLAY WHITE - COMPUTER IS BLACK"
        startComputer(session, context)
    else
        session.message = "LOCAL TWO PLAYER MODE"
    end,
    null
]

cycleLevel: fn(session: record) = [
    session.aiLevel += 1,
    if session.aiLevel > 3 then
        session.aiLevel = 1
    end,
    level: number = session.aiLevel,
    session.message = "COMPUTER LEVEL {level}",
    null
]

undo: fn(session: record) = [
    if session.history.length() > 1 then
        plies: number = 1
        if session.vsComputer and current(session).turn == 1 and session.history.length() >= 3 then
            plies = 2
        end
        previous: list = []
        for [i: number = 0, i < session.history.length() - plies, i += 1]
            previous.push(session.history@i)
        loop
        previousMoves: list = []
        previousDetails: list = []
        for [i: number = 0, i < session.moves.length() - plies, i += 1]
            previousMoves.push(session.moves@i)
            previousDetails.push(session.moveDetails@i)
        loop
        session.history = previous
        session.moves = previousMoves
        session.moveDetails = previousDetails
        session.message = "MOVE UNDONE"
    end,
    session.selected = -1,
    session.pending = false,
    session.claimed = false,
    session.thinkActive = false,
    session.wakeToken += 1,
    null
]
clickBoard: fn(session: record, context: record, x: number, y: number) = [
    state: record = current(session),
    status: record = chess.status(session.history),
    if status.finished or session.claimed or session.pending or (session.vsComputer and state.turn == -1) then
        null
    else
        c: number = math.floor((x - originX) / tile)
        r: number = math.floor((y - originY) / tile)
        if c >= 0 and c < 8 and r >= 0 and r < 8 then
            target: number = r * 8 + c
            piece: string = state.board@target
            if chess.side(piece) == state.turn then
                session.selected = target
                session.message = "SELECT A HIGHLIGHTED SQUARE"
            else if session.selected >= 0 then
                options: list = chess.legal(state)
                matched: boolean = false
                for [i: number = 0, i < options.length(), i += 1]
                    m: record = options@i
                    if m.from == session.selected and m.to == target then
                        matched = true
                        if m.promotion != "" then
                            session.pending = true
                            session.from = m.from
                            session.to = m.to
                            session.message = "PROMOTION - Q R B N"
                        else
                            commitMove(session, m)
                            startComputer(session, context)
                        end
                        break
                    end
                loop
                if not matched then
                    session.message = "ILLEGAL MOVE"
                end
            end
        end
    end,
    null
]
keyAction: fn(session: record, context: record, key: number) = [
    if session.pending then
        promo: string = ""
        when
            key == 81 then
                promo = "Q"
            key == 82 then
                promo = "R"
            key == 66 then
                promo = "B"
            key == 78 then
                promo = "N"
            otherwise
                null
        end
        if promo != "" then
            move: record = chess.findMove(current(session), session.from, session.to, promo)
            if move.valid then
                commitMove(session, move)
                startComputer(session, context)
            end
        end
    else
        when
            key == 85 then
                undo(session)
            key == 82 then
                newGame: record = newSession()
                session.history = newGame.history
                session.moves = newGame.moves
                session.moveDetails = newGame.moveDetails
                session.thinkActive = false
                session.wakeToken += 1
                session.selected = -1
                session.pending = false
                session.claimed = false
                session.message = "NEW GAME"
            key == 77 then
                toggleMode(session, context)
            key == 76 then
                cycleLevel(session)
            key == 68 then
                status: record = chess.status(session.history)
                if status.claim then
                    session.claimed = true
                    session.message = "DRAW CLAIMED"
                end
            otherwise
                null
        end
    end,
    null
]

if not graphics.available() then
    print("Beacon Chess requires the Windows native graphics backend.")
else
    app: record = window.create({ title: "Beacon Chess", width: 850, height: 670 })
    context: record = graphics.createContext(app, { renderer: graphics.renderer.opengl })
    session: record = newSession()
    window.show(app)
    draw(context, app, session)
    running: boolean = true
    for [tick: number = 0, running, tick += 1]
        event: record = window.nextEvent(app)
        when
            event.type == "close" then
                running = false
            event.type == "resize" then
                app.width = event.width
                app.height = event.height
                if app.width >= 840 and app.height >= 655 then
                    draw(context, app, session)
                end
            event.type == "mouseDown" then
                if event.x >= sidebar + 15 and event.x <= sidebar + 114 and event.y >= 354 and event.y <= 391 then
                    undo(session)
                else if event.x >= sidebar + 123 and event.x <= sidebar + 221 and event.y >= 354 and event.y <= 391 then
                    previousMode: boolean = session.vsComputer
                    previousLevel: number = session.aiLevel
                    previousToken: number = session.wakeToken
                    session = newSession()
                    session.vsComputer = previousMode
                    session.aiLevel = previousLevel
                    session.wakeToken = previousToken + 1
                else if event.x >= sidebar + 15 and event.x <= sidebar + 220 and event.y >= 405 and event.y <= 436 then
                    toggleMode(session, context)
                else if event.x >= sidebar + 15 and event.x <= sidebar + 220 and event.y >= 445 and event.y <= 476 then
                    cycleLevel(session)
                else
                    clickBoard(session, context, event.x, event.y)
                end
                if app.width >= 840 and app.height >= 655 then
                    draw(context, app, session)
                end
            event.type == "mouseMove" then
                if event.x == 32766 then
                    advanceComputer(session, context, event.y)
                    if app.width >= 840 and app.height >= 655 then
                        draw(context, app, session)
                    end
                end
            event.type == "keyDown" then
                keyAction(session, context, event.key)
                if app.width >= 840 and app.height >= 655 then
                    draw(context, app, session)
                end
            otherwise
                null
        end
    loop
    graphics.destroyContext(context)
end
