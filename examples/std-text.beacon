include std.text

print(text.length("Beacon"))
print(text.slice("Beacon", 2))
print(text.slice("Beacon", 1, 3))
print(text.contains("Beacon", "aco"))
print(text.startsWith("Beacon", "Bea"))
print(text.endsWith("Beacon", "con"))
print(text.indexOf("abcabc", "abc"))
print(text.lastIndexOf("abcabc", "abc"))
print(text.lastIndexOf("abc", ""))
print(text.join(text.split("one--two----four--", "--"), "|"))
print(text.split("Beacon", "").length())
print(text.replace("foo foo foo", "foo", "bar"))
print(text.replace("Beacon", "", "x"))
print("[" + text.trimStart(" \tBeacon") + "]")
print("[" + text.trimEnd("Beacon \r\n") + "]")
print("[" + text.trim(" \t Beacon \r\n") + "]")
print(text.join(text.lines("one\r\ntwo\rthree\nfour"), "|"))
print(text.join(["a", "b", "c"], ","))
print(text.repeat("ha", 3))
print(text.isEmpty(""))
print(text.isEmpty("Beacon"))
print(text.isBlank(" \t\r\n"))
print(text.isBlank(" Beacon "))
