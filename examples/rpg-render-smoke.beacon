include std.window
include std.graphics
include std.graphics.gl

if not window.available() then
    print("unsupported")
else
    app: record = window.create({ title: "Beacon RPG render smoke", width: 640, height: 480 })
    context: record = graphics.createContext(app, { renderer: graphics.renderer.opengl })
    window.show(app)
    graphics.gl.clearColor(context, 0.01, 0.02, 0.03, 1.0)
    graphics.gl.clear(context, graphics.gl.buffer.color)
    commands: list = [
        graphics.gl.rect(10, 10, 120, 80, { red: 0.95, green: 0.12, blue: 0.10 }),
        graphics.gl.text(170, 20, "BEACON RPG 123", 3, { red: 0.15, green: 0.93, blue: 0.20 })
    ]
    graphics.gl.drawBatch(context, 640, 480, commands)
    pixel: record = graphics.gl.samplePixel(context, 20, 440)
    print(pixel.red > 0.85 and pixel.green < 0.22 and pixel.blue < 0.2)
    // Sample the entire first glyph on its pixel grid. A thin bitmap
    // stroke may shift by one framebuffer pixel on software WGL drivers.
    glyphSeen: boolean = false
    for [row: number = 0, row < 7, row += 1]
        for [col: number = 0, col < 5, col += 1]
            glyph: record = graphics.gl.samplePixel(context, 171 + col * 3, 458 - row * 3)
            if glyph.green > 0.8 and glyph.red < 0.25 then
                glyphSeen = true
            end
        loop
    loop
    print(glyphSeen)
    graphics.present(context)
    graphics.destroyContext(context)
    window.close(app)
    closed: boolean = false
    for [tick: number = 0, not closed, tick += 1]
        event: record = window.nextEvent(app)
        if event.type == "close" then
            closed = true
        end
    loop
    print(closed)
end
