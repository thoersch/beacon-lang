include std.math

print(math.abs(-42))
print(math.min(3, 7))
print(math.max(3, 7))
print(math.clamp(-5, 0, 10))
print(math.clamp(15, 0, 10))
print(math.clamp(5, 0, 10))
print(math.floor(2.9))
print(math.floor(-2.1))
print(math.ceil(2.1))
print(math.ceil(-2.9))
print(math.round(2.5))
print(math.round(-2.5))
print(math.sqrt(81))
print(math.pow(2, 10))
print(math.mod(17, 5))
print(math.mod(-17, 5))
print(math.pi > 3.14)
print(math.e > 2.71)
