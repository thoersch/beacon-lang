// Pure Beacon chess rules. Game-local module: no third-party chess library.
// Board indices are 0..63, a8 through h1. Uppercase = White.
// Every legal move is validated against king safety before application.
include std.math
include std.text

newGame: fn() = {
    board: ["r", "n", "b", "q", "k", "b", "n", "r", "p", "p", "p", "p", "p", "p", "p", "p", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", ".", "P", "P", "P", "P", "P", "P", "P", "P", "R", "N", "B", "Q", "K", "B", "N", "R"]
    turn: 1
    wk: true
    wq: true
    bk: true
    bq: true
    ep: -1
    half: 0
    full: 1
}

row: fn(i: number) = math.floor(i / 8)
col: fn(i: number) = i - row(i) * 8
inside: fn(r: number, c: number) = r >= 0 and r < 8 and c >= 0 and c < 8
abs: fn(n: number) = math.abs(n)
sign: fn(n: number) = [
    result: number = 0,
    if n > 0 then
        result = 1
    else if n < 0 then
        result = -1
    end,
    result
]
side: fn(p: string) = [
    result: number = 0,
    if p != "." then
        if text.indexOf("PNBRQK", p) >= 0 then
            result = 1
        else
            result = -1
        end
    end,
    result
]
pieceType: fn(p: string) = [
    result: string = p,
    when
        p == "p" then
            result = "P"
        p == "n" then
            result = "N"
        p == "b" then
            result = "B"
        p == "r" then
            result = "R"
        p == "q" then
            result = "Q"
        p == "k" then
            result = "K"
        otherwise
            null
    end,
    result
]
name: fn(i: number) = "abcdefgh".slice(col(i), 1) + "{8 - row(i)}"
square: fn(file: string, rank: number) = (8 - rank) * 8 + text.indexOf("abcdefgh", file)
makeMove: fn(f: number, t: number, promotion: string, flag: string) = {
    from: f
    to: t
    promotion: promotion
    flag: flag
}
pushMove: fn(output: list, f: number, t: number, flag: string, pawn: boolean) = [
    if pawn and (row(t) == 0 or row(t) == 7) then
        for [j: number = 0, j < 4, j += 1]
            output.push(makeMove(f, t, "QRBN".slice(j, 1), flag))
        loop
    else
        output.push(makeMove(f, t, "", flag))
    end,
    null
]
clearRay: fn(board: list, f: number, t: number) = [
    dr: number = sign(row(t) - row(f)),
    dc: number = sign(col(t) - col(f)),
    r: number = row(f) + dr,
    c: number = col(f) + dc,
    free: boolean = true,
    for [j: number = 0, j < 8 and (r != row(t) or c != col(t)), j += 1]
        if not inside(r, c) or board@(r * 8 + c) != "." then
            free = false
            break
        end
        r += dr
        c += dc
    loop,
    free
]
// Can a piece on f attack t? Pawns use diagonal attack direction,
// and king attacks ignore castling by design.
attacksFrom: fn(board: list, f: number, t: number) = [
    p: string = board@f,
    k: string = pieceType(p),
    dr: number = row(t) - row(f),
    dc: number = col(t) - col(f),
    ar: number = abs(dr),
    ac: number = abs(dc),
    yes: boolean = false,
    when
        k == "P" then
            yes = dr == -side(p) and ac == 1
        k == "N" then
            yes = (ar == 2 and ac == 1) or (ar == 1 and ac == 2)
        k == "K" then
            yes = (ar <= 1 and ac <= 1) and (ar + ac > 0)
        k == "B" then
            yes = ar == ac and ar > 0 and clearRay(board, f, t)
        k == "R" then
            yes = ((ar == 0 and ac > 0) or (ac == 0 and ar > 0)) and clearRay(board, f, t)
        k == "Q" then
            yes = ((ar == ac and ar > 0) or (ar == 0 and ac > 0) or (ac == 0 and ar > 0)) and clearRay(board, f, t)
        otherwise
            null
    end,
    yes
]
attacked: fn(board: list, t: number, by: number) = [
    found: boolean = false,
    for [f: number = 0, f < 64, f += 1]
        if side(board@f) == by and attacksFrom(board, f, t) then
            found = true
            break
        end
    loop,
    found
]
kingIndex: fn(board: list, color: number) = [
    target: string = "K",
    if color == -1 then
        target = "k"
    end,
    found: number = -1,
    for [i: number = 0, i < 64, i += 1]
        if board@i == target then
            found = i
            break
        end
    loop,
    found
]
inCheck: fn(state: record, color: number) = [
    k: number = kingIndex(state.board, color),
    k < 0 or attacked(state.board, k, -color)
]
rayMoves: fn(state: record, moves: list, f: number, dr: number, dc: number) = [
    r: number = row(f) + dr,
    c: number = col(f) + dc,
    for [j: number = 0, j < 7 and inside(r, c), j += 1]
        t: number = r * 8 + c
        victim: string = state.board@t
        if side(victim) == state.turn then
            break
        end
        if pieceType(victim) != "K" then
            pushMove(moves, f, t, "", false)
        end
        if victim != "." then
            break
        end
        r += dr
        c += dc
    loop,
    null
]
pseudo: fn(state: record) = [
    moves: list = [],
    for [f: number = 0, f < 64, f += 1]
        p: string = state.board@f
        if side(p) == state.turn then
            k: string = pieceType(p)
            r: number = row(f)
            c: number = col(f)
            if k == "P" then
                ahead: number = r - state.turn
                if inside(ahead, c) and state.board@(ahead * 8 + c) == "." then
                    pushMove(moves, f, ahead * 8 + c, "", true)
                    far: number = ahead - state.turn
                    if (r == 6 and state.turn == 1) or (r == 1 and state.turn == -1) then
                        if state.board@(far * 8 + c) == "." then
                            pushMove(moves, f, far * 8 + c, "double", false)
                        end
                    end
                end
                for [dc: number = -1, dc <= 1, dc += 2]
                    tc: number = c + dc
                    if inside(ahead, tc) then
                        t: number = ahead * 8 + tc
                        victim: string = state.board@t
                        if side(victim) == -state.turn and pieceType(victim) != "K" then
                            pushMove(moves, f, t, "", true)
                        else if t == state.ep and victim == "." and pieceType(state.board@(t + state.turn * 8)) == "P" and side(state.board@(t + state.turn * 8)) == -state.turn then
                            pushMove(moves, f, t, "ep", false)
                        end
                    end
                loop
            else if k == "N" or k == "K" then
                for [dr: number = -2, dr <= 2, dr += 1]
                    for [dc: number = -2, dc <= 2, dc += 1]
                        tr: number = r + dr
                        tc: number = c + dc
                        if inside(tr, tc) and attacksFrom(state.board, f, tr * 8 + tc) then
                            t: number = tr * 8 + tc
                            if side(state.board@t) != state.turn and pieceType(state.board@t) != "K" then
                                pushMove(moves, f, t, "", false)
                            end
                        end
                    loop
                loop
            else
                for [dr: number = -1, dr <= 1, dr += 1]
                    for [dc: number = -1, dc <= 1, dc += 1]
                        if dr != 0 or dc != 0 then
                            diagonal: boolean = dr != 0 and dc != 0
                            orthogonal: boolean = dr == 0 or dc == 0
                            if (k == "B" and diagonal) or (k == "R" and orthogonal) or k == "Q" then
                                rayMoves(state, moves, f, dr, dc)
                            end
                        end
                    loop
                loop
            end
            if k == "K" and not inCheck(state, state.turn) then
                if state.turn == 1 and f == 60 then
                    if state.wk and state.board@63 == "R" and state.board@61 == "." and state.board@62 == "." and not attacked(state.board, 61, -1) and not attacked(state.board, 62, -1) then
                        pushMove(moves, 60, 62, "castle", false)
                    end
                    if state.wq and state.board@56 == "R" and state.board@59 == "." and state.board@58 == "." and state.board@57 == "." and not attacked(state.board, 59, -1) and not attacked(state.board, 58, -1) then
                        pushMove(moves, 60, 58, "castle", false)
                    end
                else if state.turn == -1 and f == 4 then
                    if state.bk and state.board@7 == "r" and state.board@5 == "." and state.board@6 == "." and not attacked(state.board, 5, 1) and not attacked(state.board, 6, 1) then
                        pushMove(moves, 4, 6, "castle", false)
                    end
                    if state.bq and state.board@0 == "r" and state.board@3 == "." and state.board@2 == "." and state.board@1 == "." and not attacked(state.board, 3, 1) and not attacked(state.board, 2, 1) then
                        pushMove(moves, 4, 2, "castle", false)
                    end
                end
            end
        end
    loop,
    moves
]
apply: fn(state: record, move: record) = [
    b: list = state.board.concat([]),
    f: number = move.from,
    t: number = move.to,
    p: string = b@f,
    victim: string = b@t,
    wk: boolean = state.wk,
    wq: boolean = state.wq,
    bk: boolean = state.bk,
    bq: boolean = state.bq,
    ep: number = -1,
    b@f = ".",
    b@t = p,
    if move.promotion != "" then
        promoted: string = move.promotion
        if state.turn == -1 then
            when
                promoted == "Q" then
                    promoted = "q"
                promoted == "R" then
                    promoted = "r"
                promoted == "B" then
                    promoted = "b"
                promoted == "N" then
                    promoted = "n"
                otherwise
                    null
            end
        end
        b@t = promoted
    end,
    if move.flag == "ep" then
        b@(t + state.turn * 8) = "."
    end,
    if move.flag == "double" then
        ep = (t + f) / 2
    end,
    if move.flag == "castle" then
        if t > f then
            b@(f + 1) = b@(f + 3)
            b@(f + 3) = "."
        else
            b@(f - 1) = b@(f - 4)
            b@(f - 4) = "."
        end
    end,
    if p == "K" then
        wk = false
        wq = false
    else if p == "k" then
        bk = false
        bq = false
    end,
    if f == 63 or t == 63 then
        wk = false
    end,
    if f == 56 or t == 56 then
        wq = false
    end,
    if f == 7 or t == 7 then
        bk = false
    end,
    if f == 0 or t == 0 then
        bq = false
    end,
    resets: boolean = pieceType(p) == "P" or victim != "." or move.flag == "ep",
    half: number = state.half + 1,
    if resets then
        half = 0
    end,
    nextFull: number = state.full,
    if state.turn == -1 then
        nextFull += 1
    end,
    {
        board: b
        turn: -state.turn
        wk: wk
        wq: wq
        bk: bk
        bq: bq
        ep: ep
        half: half
        full: nextFull
    }
]
legal: fn(state: record) = [
    options: list = pseudo(state),
    out: list = [],
    for [i: number = 0, i < options.length(), i += 1]
        move: record = options@i
        next: record = apply(state, move)
        if not inCheck(next, state.turn) then
            out.push(move)
        end
    loop,
    out
]
findMove: fn(state: record, from: number, to: number, promo: string) = [
    options: list = legal(state),
    found: record = { valid: false, from: -1, to: -1, promotion: "", flag: "" },
    for [i: number = 0, i < options.length(), i += 1]
        m: record = options@i
        if m.from == from and m.to == to and m.promotion == promo then
            found = { valid: true, from: m.from, to: m.to, promotion: m.promotion, flag: m.flag }
            break
        end
    loop,
    found
]
insufficient: fn(state: record) = [
    count: number = 0,
    bishopColor: number = -1,
    sameBishops: boolean = true,
    onlyBishops: boolean = true,
    loneMinor: boolean = true,
    for [i: number = 0, i < 64, i += 1]
        k: string = pieceType(state.board@i)
        if k != "." and k != "K" then
            count += 1
            if k != "N" and k != "B" then
                loneMinor = false
            end
            if k != "B" then
                onlyBishops = false
            else
                color: number = (row(i) + col(i)) - math.floor((row(i) + col(i)) / 2) * 2
                if bishopColor == -1 then
                    bishopColor = color
                else if color != bishopColor then
                    sameBishops = false
                end
            end
        end
    loop,
    count == 0 or (count == 1 and loneMinor) or (count > 0 and onlyBishops and sameBishops)
]
key: fn(state: record) = [
    result: string = "",
    for [i: number = 0, i < 64, i += 1]
        result += state.board@i
    loop,
    result += ":{state.turn}:{state.wk}:{state.wq}:{state.bk}:{state.bq}:",
    // En-passant is included only when a legal en-passant move exists.
    hasEp: boolean = false,
    if state.ep >= 0 then
        options: list = legal(state)
        for [i: number = 0, i < options.length(), i += 1]
            if options@i.flag == "ep" then
                hasEp = true
            end
        loop
    end,
    if hasEp then
        result += "{state.ep}"
    else
        result += "-"
    end,
    result
]
status: fn(history: list) = [
    state: record = history@(history.length() - 1),
    moves: list = legal(state),
    check: boolean = inCheck(state, state.turn),
    repeat: number = 0,
    currentKey: string = key(state),
    for [i: number = 0, i < history.length(), i += 1]
        if key(history@i) == currentKey then
            repeat += 1
        end
    loop,
    result: string = "WHITE TO MOVE",
    finished: boolean = false,
    claim: boolean = false,
    if state.turn == -1 then
        result = "BLACK TO MOVE"
    end,
    when
        moves.length() == 0 and check then
            finished = true
            if state.turn == 1 then
                result = "CHECKMATE - BLACK WINS"
            else
                result = "CHECKMATE - WHITE WINS"
            end
        moves.length() == 0 then
            finished = true
            result = "DRAW - STALEMATE"
        insufficient(state) then
            finished = true
            result = "DRAW - INSUFFICIENT MATERIAL"
        state.half >= 150 then
            finished = true
            result = "DRAW - 75 MOVE RULE"
        repeat >= 5 then
            finished = true
            result = "DRAW - FIVEFOLD REPETITION"
        otherwise
            if check then
                result += " - CHECK"
            end
            if repeat >= 3 or state.half >= 100 then
                claim = true
            end
    end,
    { message: result, finished: finished, claim: claim }
]
chess: record = {
    newGame: newGame
    row: row
    col: col
    square: square
    name: name
    side: side
    pieceType: pieceType
    makeMove: makeMove
    attacked: attacked
    inCheck: inCheck
    apply: apply
    legal: legal
    findMove: findMove
    insufficient: insufficient
    status: status
}
