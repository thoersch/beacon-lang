// Vector chessmen authored in Beacon using reusable OpenGL geometry.
// Smooth ellipses and solid polygons replace the old checker-grid pixels.
// Every piece has a distinct silhouette AND a readable base insignia.
colorWhite: record = { red: 0.98, green: 0.95, blue: 0.84 }
colorBlack: record = { red: 0.13, green: 0.19, blue: 0.27 }
colorLightRim: record = { red: 0.89, green: 0.72, blue: 0.43 }
colorDarkRim: record = { red: 0.08, green: 0.12, blue: 0.17 }
colorHighlight: record = { red: 0.99, green: 0.87, blue: 0.58 }

oval: fn(commands: list, x: number, y: number, w: number, h: number, pigment: record) = [
    commands.push(graphics.gl.ellipse(x, y, w, h, pigment)),
    null
]
block: fn(commands: list, x: number, y: number, w: number, h: number, pigment: record) = [
    commands.push(graphics.gl.rect(x, y, w, h, pigment)),
    null
]
shape: fn(commands: list, points: list, pigment: record) = [
    commands.push(graphics.gl.polygon(points, pigment)),
    null
]
v: fn(x: number, y: number) = graphics.gl.vertex(x, y)

// Beveled plinth shared by all six chess pieces. Black pieces are dark with
// a warm metallic edge; white pieces are ivory with ink-dark silhouettes.
plinth: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    oval(commands, x + 32, y + 54, 23, 5, edge),
    oval(commands, x + 32, y + 52, 20, 4, fill),
    block(commands, x + 13, y + 47, 38, 5, edge),
    block(commands, x + 16, y + 47, 32, 3, fill),
    null
]

drawPawn: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    shape(commands, [v(x+21,y+46),v(x+25,y+28),v(x+39,y+28),v(x+43,y+46)], edge),
    shape(commands, [v(x+24,y+44),v(x+28,y+29),v(x+36,y+29),v(x+40,y+44)], fill),
    oval(commands, x+32, y+23, 11, 11, edge),
    oval(commands, x+32, y+22, 8, 8, fill),
    null
]

drawRook: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    block(commands,x+19,y+20,26,27,edge),
    block(commands,x+22,y+23,20,22,fill),
    block(commands,x+16,y+13,32,9,edge),
    block(commands,x+19,y+15,26,6,fill),
    block(commands,x+16,y+10,8,9,edge),
    block(commands,x+28,y+10,8,9,edge),
    block(commands,x+40,y+10,8,9,edge),
    block(commands,x+18,y+11,4,7,fill),
    block(commands,x+30,y+11,4,7,fill),
    block(commands,x+42,y+11,4,7,fill),
    null
]

drawKnight: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    // Broad shoulders, long arched neck, pointed ears, projecting muzzle.
    shape(commands,[v(x+17,y+47),v(x+24,y+34),v(x+24,y+21),v(x+33,y+21),v(x+45,y+47)],edge),
    shape(commands,[v(x+22,y+44),v(x+28,y+32),v(x+29,y+23),v(x+34,y+26),v(x+40,y+44)],fill),
    shape(commands,[v(x+14,y+29),v(x+18,y+19),v(x+28,y+12),v(x+41,y+18),v(x+44,y+28),v(x+32,y+34),v(x+21,y+32)],edge),
    shape(commands,[v(x+18,y+27),v(x+21,y+21),v(x+29,y+16),v(x+38,y+19),v(x+40,y+26),v(x+31,y+30),v(x+22,y+29)],fill),
    shape(commands,[v(x+19,y+21),v(x+20,y+9),v(x+29,y+16)],edge),
    oval(commands,x+25,y+23,2,2,edge),
    null
]

drawBishop: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    shape(commands,[v(x+18,y+46),v(x+25,y+30),v(x+39,y+30),v(x+46,y+46)],edge),
    shape(commands,[v(x+22,y+44),v(x+28,y+31),v(x+36,y+31),v(x+42,y+44)],fill),
    oval(commands,x+32,y+27,13,17,edge),
    oval(commands,x+32,y+27,10,14,fill),
    shape(commands,[v(x+32,y+8),v(x+37,y+16),v(x+27,y+16)],edge),
    block(commands,x+29,y+20,13,3,edge),
    null
]

drawQueen: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    shape(commands,[v(x+18,y+46),v(x+23,y+24),v(x+41,y+24),v(x+46,y+46)],edge),
    shape(commands,[v(x+21,y+44),v(x+26,y+27),v(x+38,y+27),v(x+43,y+44)],fill),
    shape(commands,[v(x+18,y+28),v(x+17,y+13),v(x+27,y+22),v(x+32,y+9),v(x+37,y+22),v(x+47,y+13),v(x+46,y+28)],edge),
    shape(commands,[v(x+21,y+26),v(x+21,y+19),v(x+28,y+25),v(x+32,y+16),v(x+36,y+25),v(x+43,y+19),v(x+43,y+26)],fill),
    oval(commands,x+17,y+13,3,3,colorHighlight),
    oval(commands,x+32,y+9,3,3,colorHighlight),
    oval(commands,x+47,y+13,3,3,colorHighlight),
    null
]

drawKing: fn(commands: list, x: number, y: number, fill: record, edge: record) = [
    shape(commands,[v(x+18,y+46),v(x+24,y+25),v(x+40,y+25),v(x+46,y+46)],edge),
    shape(commands,[v(x+21,y+44),v(x+27,y+28),v(x+37,y+28),v(x+43,y+44)],fill),
    oval(commands,x+32,y+26,12,11,edge),
    oval(commands,x+32,y+25,9,8,fill),
    block(commands,x+29,y+8,6,21,edge),
    block(commands,x+23,y+13,18,6,edge),
    block(commands,x+30,y+9,4,19,colorHighlight),
    block(commands,x+24,y+14,16,3,colorHighlight),
    null
]

paintChessPiece: fn(commands: list, piece: string, x: number, y: number) = [
    fill: record = colorWhite,
    edge: record = colorDarkRim,
    labelColor: record = colorDarkRim,
    if chess.side(piece) == -1 then
        fill = colorBlack
        edge = colorLightRim
        labelColor = colorLightRim
    end,
    kind: string = chess.pieceType(piece),
    when
        kind == "P" then
            drawPawn(commands,x,y,fill,edge)
        kind == "R" then
            drawRook(commands,x,y,fill,edge)
        kind == "N" then
            drawKnight(commands,x,y,fill,edge)
        kind == "B" then
            drawBishop(commands,x,y,fill,edge)
        kind == "Q" then
            drawQueen(commands,x,y,fill,edge)
        kind == "K" then
            drawKing(commands,x,y,fill,edge)
        otherwise
            null
    end,
    plinth(commands,x,y,fill,edge),
    // Base insignia stays unobstructed and independently legible.
    block(commands,x+26,y+44,12,11,fill),
    commands.push(graphics.gl.text(x+29,y+46,kind,1,labelColor)),
    null
]

chessArt: record = {
    draw: paintChessPiece
}
