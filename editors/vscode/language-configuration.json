{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:if\\b.*\\bthen\\s*$|for\\b.*\\]\\s*$|.*=\\s*\\{\\s*$|.*=\\s*\\[\\s*$|.*\\{\\s*$)",
    "decreaseIndentPattern": "^\\s*(?:else\\b|end\\b|loop\\b|\\}|\\])"
  }
}
