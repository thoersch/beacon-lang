{
  "name": "beacon-lang",
  "displayName": "Beacon Language",
  "description": "Syntax highlighting and language configuration for Beacon.",
  "version": "0.1.1",
  "publisher": "beacon-lang",
  "repository": {
    "type": "git",
    "url": "https://github.com/thoersch/beacon-lang.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "check:syntax": "node check-syntax.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "beacon",
        "aliases": [
          "Beacon",
          "beacon"
        ],
        "extensions": [
          ".beacon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "beacon",
        "scopeName": "source.beacon",
        "path": "./syntaxes/beacon.tmLanguage.json"
      }
    ]
  }
}
